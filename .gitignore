# ============================================================================
# POS-RoR Desktop - GitIgnore
# ============================================================================

# Rails standard ignores
/rails/log/*
/rails/tmp/*
!/rails/log/.keep
!/rails/tmp/.keep
/rails/storage/*
!/rails/storage/.keep
/rails/public/assets
.byebug_history
/rails/config/master.key
/rails/config/credentials/*.key

# Desktop build artifacts - NEVER commit these
/rails/ruby/
/rails/vendor/bundle/
/rails/sqlite/
/rails/db/*.sqlite3
/rails/db/*.sqlite3-*

# Tauri build artifacts
/src-tauri/target/
/src-tauri/Cargo.lock

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Windows specific
*.msi
*.exe
*.dll
*.pdb

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Rust
/target/
**/*.rs.bk
Cargo.lock

# Cache directories
.cache/
.npm/
.yarn/
.pnpm/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.temp/
.tmp/

# Ruby
*.gem
.bundle
.yardoc
_yardoc/
doc/
.sass-cache/
.rvmrc
.rbenv-version

# Rails specific
/config/database.yml
/config/secrets.yml
/coverage/
/spec/tmp/
**.orig
rerun.txt
pickle-email-*.html
.rspec
capybara-*.html

# If you are using asset_sync
/public/assets/

# Ignore pow environment settings
.powenv

# Ignore Byebug command history file
.byebug_history

# Ignore node_modules in Rails directory if any
/rails/node_modules/

# Desktop development database
/rails/db/desktop.sqlite3
/rails/db/desktop.sqlite3-*

# Ignore prepared resources during development
/prepared_resources/

# Windows MSI build artifacts
*.wixobj
*.wixpdb
*.msi
*.msm
*.msp

# Cache for prepare_windows_resources.ps1
/cache/