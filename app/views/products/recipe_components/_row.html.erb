<div class="flex items-center space-x-4 p-4 bg-white rounded-lg border border-blue-200" data-nested-form-target="item" id="<%= dom_id(component) %>">
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-700 mb-1">Ingrediente</label>
    <div class="relative">
      <%= select_tag "product[recipe_components_attributes][][ingredient_id]", 
                     options_from_collection_for_select(Ingredient.ordered, :id, :name, component.ingredient_id),
                     class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none" %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
        <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>
  </div>
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-700 mb-1">Cantidad</label>
    <%= number_field_tag "product[recipe_components_attributes][][quantity]", 
                         component.quantity, 
                         step: "0.001", 
                         min: "0",
                         class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
  </div>
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-700 mb-1">Unidad</label>
    <div class="relative">
      <%= select_tag "product[recipe_components_attributes][][unit_id]", 
                     options_from_collection_for_select(Unit.all, :id, :name, component.unit_id),
                     class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none" %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
        <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>
  </div>
  <div class="flex-1">
    <label class="block text-sm font-medium text-gray-700 mb-1">Desperdicio (%)</label>
    <%= number_field_tag "product[recipe_components_attributes][][waste_pct]", 
                         component.waste_pct, 
                         step: "0.1", 
                         min: "0", 
                         max: "100",
                         class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
  </div>
  <button type="button" 
          class="text-red-600 hover:text-red-800 p-2" 
          data-action="click->nested-form#removeItem"
          data-url="<%= product_products_recipe_component_path(component.product, component) %>"
          data-method="delete">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
    </svg>
  </button>
</div>
