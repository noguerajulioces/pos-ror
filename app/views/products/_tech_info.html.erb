<div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl overflow-hidden">
  <div class="p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-6">Información Técnica</h3>
    
    <div class="space-y-6">
      <!-- Precios y costos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-gray-50 p-4 rounded-lg">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-gray-500">Precio de Venta</span>
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
            </svg>
          </div>
          <div class="mt-2 text-2xl font-bold text-gray-900">
            <%= number_to_currency(@product.price, delimiter: '.', precision: 0, unit: '₲s. ') %>
          </div>
          <% if @product.tax_rate %>
            <div class="mt-1 text-sm text-gray-500">
              Con IVA <%= @product.tax_rate.percentage %>%: 
              <span class="font-medium"><%= number_to_currency(@product.price_with_tax, delimiter: '.', precision: 0, unit: '₲s. ') %></span>
            </div>
          <% end %>
        </div>

        <div class="bg-gray-50 p-4 rounded-lg">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-gray-500">Costo Promedio</span>
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="mt-2 text-2xl font-bold text-gray-900">
            <%= number_to_currency(@product.current_purchase_price, delimiter: '.', precision: 0, unit: '₲s. ') %>
          </div>
          <div class="mt-1 text-sm text-gray-500">
            Margen: <span class="font-medium <%= @product.profit_margin_percentage > 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= number_to_percentage(@product.profit_margin_percentage, precision: 1) %>
            </span>
          </div>
        </div>
      </div>

      <!-- Stock -->
      <div class="bg-gray-50 p-4 rounded-lg">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-500">Stock</span>
          <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div class="mt-2 flex items-center space-x-4">
          <div>
            <span class="text-2xl font-bold text-gray-900"><%= @product.stock %></span>
            <span class="text-sm text-gray-500 ml-1"><%= @product.unit&.abbreviation %></span>
          </div>
          <div class="text-sm text-gray-500">
            Mínimo: <span class="font-medium"><%= @product.min_stock %> <%= @product.unit&.abbreviation %></span>
          </div>
          <div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
              <%= case @product.stock_status
                  when 'in_stock' then 'bg-green-100 text-green-800'
                  when 'low_stock' then 'bg-yellow-100 text-yellow-800'
                  when 'out_of_stock' then 'bg-red-100 text-red-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= case @product.stock_status
                  when 'in_stock' then 'En Stock'
                  when 'low_stock' then 'Stock Bajo'
                  when 'out_of_stock' then 'Sin Stock'
                  else 'Desconocido'
                  end %>
            </span>
          </div>
        </div>
      </div>

      <!-- Información de restaurante -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h4 class="text-sm font-medium text-gray-900 mb-2">Clasificación</h4>
          <div class="space-y-2">
            <% if @product.menu_section.present? %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Sección:</span>
                <span class="text-sm font-medium text-gray-900"><%= @product.menu_section %></span>
              </div>
            <% end %>
            
            <% if @product.kitchen_station.present? %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Estación:</span>
                <span class="text-sm font-medium text-gray-900">
                  <%= case @product.kitchen_station
                      when 'grill' then 'Parrilla'
                      when 'fryer' then 'Freidora'
                      when 'oven' then 'Horno'
                      when 'bar' then 'Bar'
                      else @product.kitchen_station.humanize
                      end %>
                </span>
              </div>
            <% end %>
            
            <% if @product.prep_time_seconds.present? && @product.prep_time_seconds > 0 %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Tiempo prep:</span>
                <span class="text-sm font-medium text-gray-900"><%= @product.prep_time_minutes %> min</span>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <h4 class="text-sm font-medium text-gray-900 mb-2">Disponibilidad</h4>
          <div class="flex flex-wrap gap-2">
            <% @product.availability_channels.each do |channel| %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= case channel
                    when 'salon' then 'Salón'
                    when 'takeaway' then 'Para Llevar'
                    when 'delivery' then 'Delivery'
                    else channel.humanize
                    end %>
              </span>
            <% end %>
          </div>
          
          <div class="mt-3 flex flex-wrap gap-2">
            <% if @product.is_featured %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Destacado
              </span>
            <% end %>
            <% if @product.is_vegan %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Vegano
              </span>
            <% end %>
            <% if @product.is_vegetarian %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Vegetariano
              </span>
            <% end %>
            <% if @product.is_gluten_free %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                Sin Gluten
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Información básica -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h4 class="text-sm font-medium text-gray-900 mb-2">Identificación</h4>
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">SKU:</span>
              <span class="text-sm font-medium text-gray-900"><%= @product.sku %></span>
            </div>
            <% if @product.barcode.present? %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Código:</span>
                <span class="text-sm font-medium text-gray-900"><%= @product.barcode %></span>
              </div>
            <% end %>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Categoría:</span>
              <span class="text-sm font-medium text-gray-900"><%= @product.category.name %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Unidad:</span>
              <span class="text-sm font-medium text-gray-900"><%= @product.unit&.name %></span>
            </div>
          </div>
        </div>

        <div>
          <h4 class="text-sm font-medium text-gray-900 mb-2">Descripción</h4>
          <p class="text-sm text-gray-700"><%= @product.description.presence || "Sin descripción" %></p>
        </div>
      </div>
    </div>
  </div>
</div>
