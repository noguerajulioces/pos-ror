<div class="bg-purple-50 shadow-sm ring-1 ring-purple-200 sm:rounded-xl">
  <div class="px-4 py-6 sm:p-8">
    <h3 class="text-lg font-semibold text-purple-900 mb-6 flex items-center">
      <svg class="h-5 w-5 text-purple-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      Grupos de Modificadores
    </h3>
    
    <div class="space-y-3">
      <% ModifierGroup.ordered.each do |group| %>
        <div class="flex items-center p-3 bg-white rounded-lg border border-purple-200">
          <%= form.check_box :modifier_group_ids, { multiple: true, class: "h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" }, group.id, nil %>
          <label class="ml-3 text-sm text-gray-900">
            <span class="font-medium"><%= group.display_name %></span>
            <span class="text-gray-500 text-xs ml-2">(<%= group.selection_range_text %>)</span>
          </label>
        </div>
      <% end %>
    </div>
    
    <p class="mt-4 text-sm text-purple-700">
      Selecciona los grupos de modificadores que estarán disponibles para este producto.
    </p>
  </div>
</div>
