<div class="bg-blue-50 shadow-sm ring-1 ring-blue-200 sm:rounded-xl" data-controller="recipe-component">
  <div class="px-4 py-6 sm:p-8">
    <h3 class="text-lg font-semibold text-blue-900 mb-6 flex items-center">
      <svg class="h-5 w-5 text-blue-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Receta e Ingredientes
    </h3>
    
    <div id="recipe_components_container" class="space-y-4" data-nested-form-target="container">
      <% @product.recipe_components.each do |component| %>
        <%= render "products/recipe_components/row", component: component %>
      <% end %>
    </div>
    
    <% if @product.recipe_components.empty? %>
      <div class="text-center py-8 text-gray-500 border-2 border-dashed border-gray-300 rounded-lg">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <p class="mt-2 text-sm font-medium">No hay ingredientes en esta receta</p>
        <p class="text-xs text-gray-400">Agrega ingredientes para completar la receta</p>
      </div>
    <% end %>
    
    <% if @product.persisted? %>
      <%= link_to ingredients_modal_picker_path(product_id: @product.id),
          data: { turbo_frame: "modal" },
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mt-4" do %>
        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Agregar Ingredientes
      <% end %>
    <% else %>
      <div class="text-center py-6 px-4 bg-gradient-to-r from-yellow-50 to-orange-50 border border-yellow-200 rounded-lg mt-4">
        <div class="flex items-center justify-center mb-3">
          <svg class="h-8 w-8 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <svg class="h-8 w-8 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-yellow-800 mb-1">¡Paso 1: Guarda el producto primero!</p>
        <p class="text-xs text-yellow-700 mb-3">Los ingredientes de la receta se pueden agregar después de crear el producto base</p>
        <div class="flex items-center justify-center space-x-2 text-xs text-yellow-600">
          <span class="bg-yellow-200 px-2 py-1 rounded-full">1. Guardar</span>
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="bg-indigo-200 px-2 py-1 rounded-full">2. Editar</span>
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="bg-green-200 px-2 py-1 rounded-full">3. Agregar Ingredientes</span>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Recipe Summary -->
<%= render "products/form/recipe_summary" if @product.persisted? %>

<!-- Modal Frame -->
<%= turbo_frame_tag "modal" %>
