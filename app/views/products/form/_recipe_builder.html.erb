<div class="bg-blue-50 shadow-sm ring-1 ring-blue-200 sm:rounded-xl">
  <div class="px-4 py-6 sm:p-8">
    <h3 class="text-lg font-semibold text-blue-900 mb-6 flex items-center">
      <svg class="h-5 w-5 text-blue-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Receta e Ingredientes
    </h3>
    
    <div id="recipe_components_container" class="space-y-4" data-nested-form-target="container">
      <% @product.recipe_components.each do |component| %>
        <%= render "products/recipe_components/row", component: component %>
      <% end %>
    </div>
    
    <%= link_to search_ingredients_path(product_id: @product.id),
        data: { turbo_frame: "modal" },
        class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mt-4" do %>
      <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      Agregar Ingrediente
    <% end %>
  </div>
</div>

<!-- Modal Frame -->
<%= turbo_frame_tag "modal" %>
