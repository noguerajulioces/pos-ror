<%= form_with(model: @product, class: "bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl md:col-span-3", data: { controller: "product-kind" }) do |form| %>
  <% if @product.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Se encontraron <%= @product.errors.count %> errores:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @product.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="px-4 py-6 sm:p-8">
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:grid-cols-2">
      <!-- Información básica -->
      <div class="col-span-1">
        <%= form.label :name, "Nombre", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :name, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :kind, "Tipo de Producto", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2 relative">
          <%= form.select :kind, 
              options_for_select([
                ['Simple', 'simple'],
                ['Receta', 'recipe'],
                ['Combo', 'combo'],
                ['Modificador', 'modifier']
              ], @product.kind),
              { prompt: "Selecciona el tipo" },
              { 
                class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none",
                data: { 
                  product_kind_target: "kind",
                  action: "change->product-kind#toggleSections"
                }
              } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :unit_id, "Unidad de Medida", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.collection_select :unit_id, Unit.all, :id, :name, { prompt: "Selecciona una unidad" },
              class: "block w-full rounded-md bg-white px-3 py-2.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-2" data-controller="image-preview">
        <label for="product_image" class="block text-sm font-medium text-gray-900">
          Imagen de Producto
        </label>
        <div class="mt-2 flex flex-col items-center justify-center rounded-lg border border-dashed border-gray-900/25 px-6 py-10">
          <div class="text-center">
            <% unless @product.images.any? { |pi| pi.image.attached? } %>
              <!-- Ícono decorativo con data target -->
              <svg data-image-preview-target="svg" class="mx-auto h-12 w-12 text-gray-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z" clip-rule="evenodd" />
              </svg>
            <% end %>

            <!-- Label para subir archivo -->
            <div class="mt-4 flex text-sm text-gray-600">
              <label for="product_image"
                    class="relative cursor-pointer rounded-md bg-white font-semibold text-indigo-600 
                            focus-within:ring-2 focus-within:ring-indigo-600 focus-within:ring-offset-2 
                            hover:text-indigo-500">
                <span>Subir Imagen</span>
                <%= form.file_field :image,
                    accept: "image/png,image/jpeg",
                    direct_upload: true,
                    id: "product_image",
                    data: {
                      action: "change->image-preview#previewImage",
                      image_preview_target: "input"
                    },
                    class: "sr-only" %>
              </label>
            </div>

            <!-- Contenedor para la vista previa -->
            <div data-image-preview-target="preview" class="mt-4 w-full max-w-lg">
              <% if @product.images.any? { |pi| pi.image.attached? } %>
                <%= image_tag @product.images.first.image.variant(resize_to_fill: [300, 300]),
                      alt: "Vista previa",
                      class: "w-[300px] h-[300px] object-cover rounded-md mx-auto" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :sku, "SKU", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :sku, class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :category_id, "Categoría", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.collection_select :category_id, Category.where.not(parent_id: nil), :id, :name, 
              { prompt: "Selecciona una categoría" }, 
              class: "block w-full rounded-md bg-white px-3 py-2.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :price, "Precio", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :price,
            value: number_with_delimiter(@product.price.to_i, delimiter: '.'),
            data: {
                  controller: "number-format",
                  "number-format-target": "input",
                  action: "input->number-format#formatNumber"
                },
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6", required: true%>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :manual_purchase_price, "Precio de Compra Manual", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :manual_purchase_price,
            value: @product.manual_purchase_price.present? ? number_with_delimiter(@product.manual_purchase_price.to_i, delimiter: '.') : nil,
            data: {
                  controller: "number-format",
                  "number-format-target": "input",
                  action: "input->number-format#formatNumber"
                },
            class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6"
             %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :stock, "Stock", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.number_field :stock, step: "0.001", min: "0", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :min_stock, "Stock Mínimo", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.number_field :min_stock, step: "0.001", min: "0", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-2">
        <%= form.label :description, "Descripción", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_area :description, rows: 3, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <!-- Campos de restaurante -->
      <div class="col-span-1">
        <%= form.label :kitchen_station, "Estación de Cocina", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2 relative">
          <%= form.select :kitchen_station, 
              options_for_select([
                ['Parrilla', 'grill'],
                ['Freidora', 'fryer'],
                ['Horno', 'oven'],
                ['Bar', 'bar']
              ], @product.kitchen_station),
              { prompt: "Selecciona estación" },
              { 
                class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none"
              } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :tax_rate_id, "Impuesto", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2 relative">
          <%= form.collection_select :tax_rate_id, TaxRate.active, :id, :display_name,
              { prompt: "Selecciona IVA" },
              { 
                class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none"
              } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :print_name, "Nombre para Impresión", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :print_name, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :menu_section, "Sección del Menú", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.text_field :menu_section, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :prep_time_seconds, "Tiempo de Preparación (minutos)", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.number_field :prep_time_seconds, min: 0, step: 30, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <div class="col-span-1">
        <%= form.label :sort_order, "Orden de Visualización", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <%= form.number_field :sort_order, min: 0, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
        </div>
      </div>

      <!-- Canales de disponibilidad -->
      <div class="col-span-2">
        <label class="block text-sm/6 font-medium text-gray-900 mb-2">Canales de Disponibilidad</label>
        <div class="grid grid-cols-3 gap-4">
          <div class="flex items-center">
            <%= form.check_box :availability_channels, { multiple: true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" }, "salon", nil %>
            <label class="ml-2 text-sm text-gray-900">Salón</label>
          </div>
          <div class="flex items-center">
            <%= form.check_box :availability_channels, { multiple: true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" }, "takeaway", nil %>
            <label class="ml-2 text-sm text-gray-900">Para Llevar</label>
          </div>
          <div class="flex items-center">
            <%= form.check_box :availability_channels, { multiple: true, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" }, "delivery", nil %>
            <label class="ml-2 text-sm text-gray-900">Delivery</label>
          </div>
        </div>
      </div>

      <!-- Flags nutricionales -->
      <div class="col-span-2">
        <label class="block text-sm/6 font-medium text-gray-900 mb-2">Información Nutricional</label>
        <div class="grid grid-cols-3 gap-4">
          <div class="flex items-center">
            <%= form.check_box :is_featured, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <label class="ml-2 text-sm text-gray-900">Destacado</label>
          </div>
          <div class="flex items-center">
            <%= form.check_box :is_vegan, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <label class="ml-2 text-sm text-gray-900">Vegano</label>
          </div>
          <div class="flex items-center">
            <%= form.check_box :is_vegetarian, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <label class="ml-2 text-sm text-gray-900">Vegetariano</label>
          </div>
          <div class="flex items-center">
            <%= form.check_box :is_gluten_free, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
            <label class="ml-2 text-sm text-gray-900">Sin Gluten</label>
          </div>
        </div>
      </div>

      <!-- Sección de Receta (solo para productos tipo recipe) -->
      <div id="recipe-section" class="col-span-6 hidden" data-product-kind-target="recipeSection">
        <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
          <h3 class="text-lg font-medium text-blue-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-blue-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Receta e Ingredientes
          </h3>
          
          <div class="space-y-4">
            <% @product.recipe_components.each do |component| %>
              <div class="flex items-center space-x-4 p-3 bg-white rounded border">
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Ingrediente</label>
                  <%= form.collection_select :ingredient_id, Ingredient.ordered, :id, :name,
                      { selected: component.ingredient_id },
                      { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                </div>
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Cantidad</label>
                  <%= form.number_field :quantity, value: component.quantity, step: "0.001", min: "0",
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Unidad</label>
                  <%= form.collection_select :unit_id, Unit.all, :id, :name,
                      { selected: component.unit_id },
                      { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                </div>
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Desperdicio (%)</label>
                  <%= form.number_field :waste_pct, value: component.waste_pct, step: "0.1", min: "0", max: "100",
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
                <button type="button" class="text-red-600 hover:text-red-800">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            <% end %>
            
            <button type="button" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              Agregar Ingrediente
            </button>
          </div>
        </div>
      </div>

      <!-- Sección de Combo (solo para productos tipo combo) -->
      <div id="combo-section" class="col-span-6 hidden" data-product-kind-target="comboSection">
        <div class="bg-green-50 p-4 rounded-lg border border-green-200">
          <h3 class="text-lg font-medium text-green-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-green-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            Componentes del Combo
          </h3>
          
          <div class="space-y-4">
            <% @product.combo_items.each do |item| %>
              <div class="flex items-center space-x-4 p-3 bg-white rounded border">
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Producto</label>
                  <%= form.collection_select :component_product_id, Product.available, :id, :name,
                      { selected: item.component_product_id },
                      { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                </div>
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-700">Cantidad</label>
                  <%= form.number_field :quantity, value: item.quantity, step: "0.001", min: "0",
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
                <div class="flex items-center">
                  <%= form.check_box :optional, checked: item.optional, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
                  <label class="ml-2 text-sm text-gray-700">Opcional</label>
                </div>
                <button type="button" class="text-red-600 hover:text-red-800">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            <% end %>
            
            <button type="button" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-green-700 bg-green-100 hover:bg-green-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
              <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              Agregar Componente
            </button>
          </div>
        </div>
      </div>

      <!-- Sección de Modificadores (solo para productos tipo modifier) -->
      <div id="modifier-section" class="col-span-6 hidden" data-product-kind-target="modifierSection">
        <div class="bg-purple-50 p-4 rounded-lg border border-purple-200">
          <h3 class="text-lg font-medium text-purple-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-purple-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            Grupos de Modificadores
          </h3>
          
          <div class="space-y-3">
            <% ModifierGroup.ordered.each do |group| %>
              <div class="flex items-center">
                <%= form.check_box :modifier_group_ids, { multiple: true, class: "h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" }, group.id, nil %>
                <label class="ml-2 text-sm text-gray-900">
                  <%= group.display_name %>
                  <span class="text-gray-500 text-xs">(<%= group.selection_range_text %>)</span>
                </label>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sección Simple (para productos tipo simple) -->
      <div id="simple-section" class="col-span-6" data-product-kind-target="simpleSection">
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-gray-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            Producto Simple
          </h3>
          <p class="text-sm text-gray-600">Este es un producto simple que no requiere configuración adicional.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
    <%= link_to "Cancelar", products_path, class: "text-sm/6 font-semibold text-gray-900" %>
    <%= form.submit "Guardar", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
  </div>
<% end %>