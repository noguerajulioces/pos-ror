<%= form_with(model: @product, class: "space-y-8", data: { controller: "product-kind nested-form image-preview" }) do |form| %>
  <!-- Campo oculto para permitir edición de productos de receta sin ingredientes -->
  <%= hidden_field_tag :allow_empty_recipe, "1" if @product.kind == 'recipe' %>
  <% if @product.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Se encontraron <%= @product.errors.count %> errores:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @product.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Datos básicos -->
  <%= render 'products/form/basics_fields', form: form %>

  <!-- Clasificación y cocina -->
  <%#= render 'products/form/kitchen_fields', form: form %>

  <!-- Impuestos -->
  <%= render 'products/form/taxes_fields', form: form %>

  <!-- Nutricional -->
  <%#= render 'products/form/nutrition_fields', form: form %>

  <!-- Imágenes -->
  <%= render 'products/form/images_field', form: form %>

  <!-- Descripción -->
  <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
    <div class="px-4 py-6 sm:p-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Descripción</h3>
      <div>
        <%= form.text_area :description, rows: 4, 
            class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6",
            placeholder: "Describe el producto..." %>
      </div>
    </div>
  </div>

  <!-- Secciones condicionales según tipo -->
  <div data-product-kind-target="recipeSection" class="hidden">
    <%= render 'products/form/recipe_builder', form: form %>
  </div>

  <div data-product-kind-target="comboSection" class="hidden">
    <%= render 'products/form/combo_builder', form: form %>
  </div>

  <div data-product-kind-target="modifierSection" class="hidden">
    <%= render 'products/form/modifiers_fields', form: form %>
  </div>

  <div data-product-kind-target="simpleSection">
    <div class="bg-gray-50 shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
      <div class="px-4 py-6 sm:p-8">
        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
          <svg class="h-5 w-5 text-gray-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          Producto Simple
        </h3>
        <p class="text-sm text-gray-600">Este es un producto simple que no requiere configuración adicional.</p>
      </div>
    </div>
  </div>

  <!-- Botones de acción -->
  <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
    <%= link_to "Cancelar", products_path, class: "text-sm/6 font-semibold text-gray-900" %>
    <%= form.submit "Guardar", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
  </div>
<% end %>