<div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
      <svg class="h-5 w-5 text-green-600 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
      </svg>
      Componentes del Combo
    </h3>
  </div>
  
  <% if @product.combo_items.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cantidad</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subtotal</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% total_components_cost = 0 %>
          <% @product.combo_items.each do |item| %>
            <% component_cost = item.component_product.price * item.quantity %>
            <% total_components_cost += component_cost %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= item.component_product.name %>
                <% if item.optional %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">
                    Opcional
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= item.quantity %> <%= item.component_product.unit&.abbreviation %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= number_to_currency(item.component_product.price, delimiter: '.', precision: 0, unit: '₲s. ') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= number_to_currency(component_cost, delimiter: '.', precision: 0, unit: '₲s. ') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= case item.component_product.kind
                      when 'simple' then 'bg-blue-100 text-blue-800'
                      when 'recipe' then 'bg-purple-100 text-purple-800'
                      when 'combo' then 'bg-green-100 text-green-800'
                      when 'modifier' then 'bg-orange-100 text-orange-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= item.component_product.kind.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= item.component_product.stock > 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= item.component_product.stock %> <%= item.component_product.unit&.abbreviation %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <!-- Resumen de precios -->
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <span class="text-sm font-medium text-gray-500">Precio del Combo:</span>
          <div class="text-lg font-bold text-gray-900">
            <%= number_to_currency(@product.price, delimiter: '.', precision: 0, unit: '₲s. ') %>
          </div>
        </div>
        
        <div>
          <span class="text-sm font-medium text-gray-500">Suma de Componentes:</span>
          <div class="text-lg font-bold text-gray-900">
            <%= number_to_currency(total_components_cost, delimiter: '.', precision: 0, unit: '₲s. ') %>
          </div>
        </div>
        
        <% if @product.price > 0 && total_components_cost > 0 %>
          <% discount = total_components_cost - @product.price %>
          <div>
            <span class="text-sm font-medium text-gray-500">Descuento del Combo:</span>
            <div class="text-lg font-bold <%= discount > 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= number_to_currency(discount, delimiter: '.', precision: 0, unit: '₲s. ') %>
              <% if total_components_cost > 0 %>
                (<%= number_to_percentage((discount / total_components_cost * 100), precision: 1) %>)
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="px-6 py-8 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
      </svg>
      <p class="mt-2 text-sm text-gray-500">Aún sin componentes configurados</p>
    </div>
  <% end %>
</div>
