<div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl overflow-hidden">
  <div class="p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Imágenes del Producto</h3>
    
    <% if @product.images.any? %>
      <!-- Imagen principal -->
      <div class="mb-4">
        <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden bg-gray-100">
          <%= image_tag @product.images.first.image.variant(resize_to_fill: [400, 300]), 
              class: "w-full h-full object-cover", 
              alt: @product.name %>
        </div>
      </div>
      
      <!-- Thumbnails -->
      <% if @product.images.count > 1 %>
        <div class="grid grid-cols-4 gap-2">
          <% @product.images.each do |image| %>
            <div class="aspect-w-1 aspect-h-1 rounded-md overflow-hidden bg-gray-100">
              <%= image_tag image.image.variant(resize_to_fill: [100, 100]), 
                  class: "w-full h-full object-cover cursor-pointer hover:opacity-75 transition-opacity", 
                  alt: @product.name %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- Placeholder -->
      <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden bg-gray-100 flex items-center justify-center">
        <div class="text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="mt-2 text-sm text-gray-500">Sin imagen</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
