<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Usuarios</h1>
      <p class="mt-1 text-sm text-gray-500">Lista de usuarios registrados en esta cuenta.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_user_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 inline-flex items-center gap-x-1.5" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
        </svg>
        Nuevo usuario
      <% end %>
    </div>
  </div>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="mt-6 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Usuario</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Roles</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Estado</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Registro</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% if @users.empty? %>
                <tr>
                  <td colspan="5" class="py-16 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                    <p class="mt-3 text-sm font-medium text-gray-900">Sin usuarios</p>
                    <p class="mt-1 text-sm text-gray-500">No hay usuarios registrados todavía.</p>
                  </td>
                </tr>
              <% else %>
                <% @users.each do |user| %>
                  <tr class="hover:bg-gray-50 transition-colors duration-100 <%= 'opacity-60' unless user.active? %>">

                    <%# Usuario: avatar + nombre + email %>
                    <td class="py-3 pl-4 pr-3 sm:pl-6">
                      <div class="flex items-center gap-x-3">
                        <div class="h-9 w-9 flex-shrink-0 rounded-full <%= user.super_user? ? 'bg-purple-500' : 'bg-indigo-500' %> flex items-center justify-center">
                          <span class="text-sm font-semibold text-white">
                            <%= user.name&.first&.upcase || user.email.first.upcase %>
                          </span>
                        </div>
                        <div class="min-w-0">
                          <div class="flex items-center gap-x-2">
                            <p class="text-sm font-medium text-gray-900 truncate"><%= user.name || '—' %></p>
                            <% if user.super_user? %>
                              <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">
                                Super usuario
                              </span>
                            <% end %>
                            <% if user == current_user %>
                              <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">Tú</span>
                            <% end %>
                          </div>
                          <p class="text-xs text-gray-400 mt-0.5 truncate"><%= user.email %></p>
                        </div>
                      </div>
                    </td>

                    <%# Roles %>
                    <td class="px-3 py-3">
                      <div class="flex flex-wrap gap-1">
                        <% if user.roles.any? %>
                          <% user.roles.each do |role| %>
                            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                              <%= role.name.humanize %>
                            </span>
                          <% end %>
                        <% else %>
                          <span class="text-xs text-gray-400">Sin roles</span>
                        <% end %>
                      </div>
                    </td>

                    <%# Estado %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <% if user.active? %>
                        <span class="inline-flex items-center gap-x-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">
                          <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                          Activo
                        </span>
                      <% else %>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">
                          Inactivo
                        </span>
                      <% end %>
                    </td>

                    <%# Fecha de registro %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">
                      <%= user.created_at.strftime("%d/%m/%Y") %>
                    </td>

                    <%# Acciones %>
                    <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-6">
                      <div class="flex items-center justify-end gap-x-2">
                        <%= link_to user_path(user),
                            title: "Ver usuario",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                          </svg>
                        <% end %>

                        <% if current_user.super_user? || user == current_user %>
                          <%= link_to edit_user_path(user),
                              title: "Editar usuario",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          <% end %>
                        <% else %>
                          <span
                            title="Solo puedes editar tu propio usuario"
                            class="inline-flex items-center rounded-md bg-gray-50 px-2.5 py-1.5 text-xs font-semibold text-gray-300 ring-1 ring-inset ring-gray-200 cursor-not-allowed">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          </span>
                        <% end %>

                        <% if user.active? %>
                          <% if current_user.can_deactivate_users? && user != current_user %>
                            <%= link_to deactivate_user_path(user),
                                data: { turbo_method: :patch, turbo_confirm: "¿Desactivar este usuario?" },
                                title: "Desactivar",
                                class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-orange-600 shadow-sm ring-1 ring-inset ring-orange-200 hover:bg-orange-50" do %>
                              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                              </svg>
                            <% end %>
                          <% end %>
                        <% else %>
                          <%= link_to activate_user_path(user),
                              data: { turbo_method: :patch, turbo_confirm: "¿Activar este usuario?" },
                              title: "Activar",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-green-600 shadow-sm ring-1 ring-inset ring-green-200 hover:bg-green-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                          <% end %>
                        <% end %>
                      </div>
                    </td>

                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────── %>
  <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
    <%= will_paginate @users, renderer: TailwindPaginateRenderer %>
  </div>

</div>
