<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Compras</h1>
      <p class="mt-1 text-sm text-gray-500">Lista de compras registradas.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_purchase_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 inline-flex items-center gap-x-1.5" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nueva compra
      <% end %>
    </div>
  </div>

  <%# ── Search form ─────────────────────────────────────────────────────── %>
  <%= search_form_for @q, url: purchases_path, class: "mt-6" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-x-6 gap-y-4">
          <div>
            <%= f.label :supplier_company_name_or_supplier_contact_name_cont, "Proveedor", class: "block text-sm font-medium text-gray-900" %>
            <%= f.search_field :supplier_company_name_or_supplier_contact_name_cont,
                placeholder: "Empresa o contacto…",
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :status_eq, "Estado", class: "block text-sm font-medium text-gray-900" %>
            <%= f.select :status_eq,
                options_for_select([
                  ['Todos los estados', ''],
                  ['Borrador', 'draft'],
                  ['Confirmada', 'posted'],
                  ['Cancelada', 'canceled']
                ], params.dig(:q, :status_eq)),
                {},
                class: "mt-1 block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :purchase_date_gteq, "Fecha desde", class: "block text-sm font-medium text-gray-900" %>
            <%= f.date_field :purchase_date_gteq,
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :purchase_date_lteq, "Fecha hasta", class: "block text-sm font-medium text-gray-900" %>
            <%= f.date_field :purchase_date_lteq,
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-x-3 border-t border-gray-900/10 px-4 py-3 sm:px-6">
        <%= f.submit "Buscar",
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <%= link_to "Limpiar", purchases_path,
            class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="mt-6 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Compra</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Proveedor</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Estado</th>
                <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Total</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% if @purchases.empty? %>
                <tr>
                  <td colspan="5" class="py-16 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                    </svg>
                    <p class="mt-3 text-sm font-medium text-gray-900">Sin compras</p>
                    <p class="mt-1 text-sm text-gray-500">No se encontraron compras con los filtros aplicados.</p>
                    <%= link_to "Limpiar filtros", purchases_path, class: "mt-4 inline-block text-sm text-indigo-600 hover:text-indigo-500 underline" %>
                  </td>
                </tr>
              <% else %>
                <% @purchases.each do |purchase| %>
                  <tr class="hover:bg-gray-50 transition-colors duration-100 <%= 'opacity-60' unless purchase.posted? %>">

                    <%# Compra: ID + fecha %>
                    <td class="whitespace-nowrap py-3 pl-4 pr-3 sm:pl-6">
                      <span class="block text-sm font-semibold text-gray-900">#<%= purchase.id.to_s.rjust(4, '0') %></span>
                      <span class="block text-xs text-gray-400 mt-0.5">
                        <%= purchase.purchase_date&.strftime("%d/%m/%Y") || '—' %>
                      </span>
                    </td>

                    <%# Proveedor %>
                    <td class="px-3 py-3">
                      <div class="flex items-center gap-x-2">
                        <div class="h-7 w-7 flex-shrink-0 rounded-full bg-emerald-100 flex items-center justify-center">
                          <span class="text-xs font-semibold text-emerald-700">
                            <%= (purchase.supplier.company_name.presence || purchase.supplier.contact_name).first.upcase %>
                          </span>
                        </div>
                        <span class="text-sm text-gray-900">
                          <%= purchase.supplier.company_name.presence || purchase.supplier.contact_name %>
                        </span>
                      </div>
                    </td>

                    <%# Estado %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <% if purchase.posted? %>
                        <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Confirmada</span>
                      <% elsif purchase.draft? %>
                        <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-700">Borrador</span>
                      <% elsif purchase.canceled? %>
                        <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Cancelada</span>
                      <% else %>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Sin estado</span>
                      <% end %>
                    </td>

                    <%# Total %>
                    <td class="whitespace-nowrap px-3 py-3 text-right">
                      <span class="text-sm font-semibold text-gray-900">
                        ₲ <%= number_with_delimiter(purchase.total_amount.to_i, delimiter: '.') %>
                      </span>
                    </td>

                    <%# Acciones %>
                    <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-6">
                      <div class="flex items-center justify-end gap-x-2">
                        <%= link_to purchase_path(purchase),
                            title: "Ver compra",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                          </svg>
                        <% end %>

                        <% if purchase.editable? %>
                          <%= link_to edit_purchase_path(purchase),
                              title: "Editar compra",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          <% end %>
                        <% else %>
                          <span
                            title="No se puede editar una compra <%= purchase.posted? ? 'confirmada' : 'cancelada' %>"
                            class="inline-flex items-center rounded-md bg-gray-50 px-2.5 py-1.5 text-xs font-semibold text-gray-300 ring-1 ring-inset ring-gray-200 cursor-not-allowed">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          </span>
                        <% end %>
                      </div>
                    </td>

                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────── %>
  <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
    <%= will_paginate @purchases, renderer: TailwindPaginateRenderer %>
  </div>

</div>
