<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900">Compras</h1>
      <p class="mt-2 text-sm text-gray-700">Lista de compras registradas.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to "Nueva Compra", new_purchase_path, class: "block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  </div>

  <!-- Search Form -->
  <%= search_form_for @q, class: "mt-6" do |f| %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h3 class="text-base font-medium text-gray-900 mb-6">Filtros de Búsqueda</h3>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <%= f.label :supplier_company_name_or_supplier_contact_name_cont, "Proveedor", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.search_field :supplier_company_name_or_supplier_contact_name_cont, 
              placeholder: "Buscar por nombre de empresa o contacto",
              class: "block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2.5 text-sm transition-colors duration-200" %>
        </div>

        <div>
          <%= f.label :status_eq, "Estado", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :status_eq, 
              options_for_select([
                ['Todos los estados', ''],
                ['Borrador', 'draft'],
                ['Confirmada', 'posted'],
                ['Cancelada', 'canceled']
              ], params.dig(:q, :status_eq)),
              {},
              class: "block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2.5 text-sm transition-colors duration-200" %>
        </div>

        <div>
          <%= f.label :purchase_date_gteq, "Fecha desde", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :purchase_date_gteq, 
              class: "block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2.5 text-sm transition-colors duration-200" %>
        </div>

        <div>
          <%= f.label :purchase_date_lteq, "Fecha hasta", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :purchase_date_lteq, 
              class: "block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2.5 text-sm transition-colors duration-200" %>
        </div>
      </div>
      
      <div class="mt-6 flex gap-3">
        <button type="submit" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Buscar
        </button>
        <%= link_to purchases_path, class: "inline-flex items-center rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Limpiar
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">#</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Fecha</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Proveedor</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Estado</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Total</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @purchases.each.with_index(1) do |purchase, index| %>
                <tr class="<%= 'opacity-60' unless purchase.posted? %>">
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                    <%= index %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= purchase.purchase_date&.strftime("%d/%m/%Y") %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= purchase.supplier.company_name.present? ? purchase.supplier.company_name : purchase.supplier.contact_name %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4">
                    <% if purchase.posted? %>
                      <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                        Confirmada
                      </span>
                    <% elsif purchase.draft? %>
                      <span class="inline-flex items-center rounded-md bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">
                        Borrador
                      </span>
                    <% elsif purchase.canceled? %>
                      <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">
                        Cancelada
                      </span>
                    <% else %>
                      <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">
                        Sin estado
                      </span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    ₲s. <%= number_with_delimiter(purchase.total_amount.to_i, delimiter: '.') %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <%= link_to "Ver", purchase_path(purchase), class: "text-indigo-600 hover:text-indigo-900" %>
                    <% if purchase.editable? %>
                      <%= link_to "Editar", edit_purchase_path(purchase), class: "ml-2 text-indigo-600 hover:text-indigo-900" %>
                    <% else %>
                      <span class="ml-2 text-gray-400 cursor-not-allowed" title="No se puede editar una compra <%= purchase.status == 'posted' ? 'confirmada' : 'cancelada' %>">
                        Editar
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-4 justify-center border-t flex">
  <%= will_paginate @purchases, renderer: TailwindPaginateRenderer %>
</div>