<%= form_with(model: purchase, class: "bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl w-full", 
    data: { 
      controller: 'purchase-calculator'
    }) do |form| %>
  <% if purchase.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            Se encontraron <%= pluralize(purchase.errors.count, "error") %>:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% purchase.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="px-4 py-6 sm:p-8">
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
      <div class="sm:col-span-2">
        <%= form.label :purchase_date, "Fecha de Compra", class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.date_field :purchase_date, value: Date.current, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :supplier_id, "Proveedor", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="relative">
          <%= form.collection_select :supplier_id, 
              Supplier.all, 
              :id, 
              ->(supplier) { "#{supplier.company_name.present? ? supplier.company_name : supplier.contact_name} (#{supplier&.document})" }, 
              { include_blank: 'Seleccione un proveedor' }, 
              { class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none", required: true } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :invoice_number, "Número de Factura", class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.text_field :invoice_number, class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :payment_method, "Método de Pago", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="relative">
          <%= form.select :payment_method, 
              options_for_select([
                ['Efectivo', 'cash'],
                ['Tarjeta de Crédito', 'credit_card'],
                ['Tarjeta de Débito', 'debit_card'],
                ['Transferencia', 'transfer'],
                ['Cheque', 'check']
              ], purchase.payment_method), 
              { include_blank: 'Seleccione método de pago' }, 
              { class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none", required: true } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
      </div>

      <div class="sm:col-span-4">
        <%= form.label :notes, "Notas", class: "block text-sm/6 font-medium text-gray-900" %>
        <%= form.text_area :notes, rows: 3, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
    </div>
  </div>

  <div class="px-4 py-6 sm:px-8 sm:py-6 border-t border-gray-200 w-full">
    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">Items de Compra</h3>
    
    <div data-controller="rails-nested-form" 
         data-rails-nested-form-wrapper-selector-value=".nested-form-wrapper">
      
      <div class="space-y-4 w-full overflow-x-auto">
        <%= form.fields_for :purchase_items do |item_form| %>
          <%= render 'purchase_item_fields', f: item_form %>
        <% end %>
        
        <!-- Target where new items will be inserted -->
        <div data-rails-nested-form-target="target"></div>
      </div>

      <template data-rails-nested-form-target="template">
        <%= form.fields_for :purchase_items, PurchaseItem.new, child_index: 'NEW_RECORD' do |item_form| %>
          <%= render 'purchase_item_fields', f: item_form %>
        <% end %>
      </template>

      <div class="mt-6">
        <button type="button" 
                data-action="click->rails-nested-form#add"
                class="inline-flex items-center rounded-md bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Agregar Item
        </button>
      </div>
    </div>
  </div>

  <div class="px-4 py-6 sm:p-8 border-t border-gray-200">
    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-6">Resumen</h3>
    
    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
      <div class="sm:col-span-3 sm:col-start-4">
        <%= form.label :total_amount, "Monto Total", class: "block text-sm/6 font-medium text-gray-900" %>
        <div class="mt-2">
          <div class="flex items-center rounded-md bg-gray-50 px-3 outline outline-1 -outline-offset-1 outline-gray-300" data-controller="number-format">
            <div class="shrink-0 text-base text-gray-500 select-none sm:text-sm/6 font-medium">Gs.</div>
            <%= form.text_field :total_amount, 
                placeholder: "0",
                class: "block min-w-0 grow bg-gray-50 py-1.5 pr-3 pl-1 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 text-right font-bold text-lg", 
                id: "purchase_total_amount",
                readonly: true,
                data: { 
                  "purchase-calculator-target": "totalAmount",
                  "number-format-target": "input"
                } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
    <%= link_to purchases_path, class: "text-sm font-semibold leading-6 text-gray-900" do %>
      Cancelar
    <% end %>
    <%= form.button type: "submit", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
      <%= purchase.new_record? ? "Crear Compra" : "Actualizar Compra" %>
    <% end %>
  </div>
<% end %>