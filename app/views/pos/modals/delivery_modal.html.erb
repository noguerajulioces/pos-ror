<turbo-frame id="delivery_modal">
  <div class="p-6">
    <%= form_with url: pos_assign_delivery_path, method: :post, local: false, data: { controller: "delivery" } do |f| %>
      <p class="text-sm text-gray-600 mb-4">
        Ingresa el monto de delivery. El repartidor se asignará después en la pantalla de órdenes.
      </p>
      
      <div class="mb-4">
        <%= f.label :amount, "Monto de Delivery", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :amount, 
            step: 0.01, 
            min: 0, 
            value: session[:delivery_amount],
            placeholder: "0.00",
            class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>
      
      <div class="flex justify-end">
        <button type="button" class="mr-2 px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" data-action="click->modal#close">
          Cancelar
        </button>
        <%= f.submit "Guardar Monto", class: "px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
