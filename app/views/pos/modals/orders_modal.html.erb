<turbo-frame id="orders_modal">
  <div class="px-4">
    <!-- Tabs for order status -->
    <div class="border-b border-gray-200 mb-4">
      <nav class="flex space-x-4" aria-label="Order status">
        <button class="px-3 py-2 text-sm font-medium text-indigo-600 border-b-2 border-indigo-600">
          En espera
        </button>
      </nav>
    </div>

    <!-- Search bar -->
    <div class="mb-4">
      <div class="flex">
        <input type="text" 
               placeholder="Buscar pedidos..." 
               class="flex-grow px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
               data-controller="order-search"
               data-action="input->order-search#search" />
        <button class="bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-r-md">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Orders list -->
    <div class="overflow-y-auto max-h-96">
      <div id="orders-list" class="space-y-2">
        <% if @orders&.any? %>
          <% @orders.each do |order| %>
            <div class="border rounded-lg p-4 hover:bg-gray-50 hover:shadow-md transition-shadow">
              <div class="flex justify-between items-start mb-3">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-lg font-bold text-gray-900">#<%= order.id.to_s.rjust(4, '0') %></h3>
                    <span class="px-2 py-1 text-xs font-medium rounded-full
                      <%= case order.status
                          when 'on_hold' then 'bg-yellow-100 text-yellow-800'
                          when 'unpaid' then 'bg-red-100 text-red-800'
                          when 'partially_paid' then 'bg-blue-100 text-blue-800'
                          end %>">
                      En Espera
                    </span>
                    <% if order.order_type == 'delivery' %>
                      <span class="px-2 py-1 text-xs font-medium rounded-full bg-orange-100 text-orange-800">
                        🚚 Delivery
                      </span>
                    <% end %>
                  </div>
                  <div class="space-y-1">
                    <p class="text-xs text-gray-500">
                      <%= order.order_date.strftime("%d/%m/%Y %H:%M") %>
                    </p>
                    <% if order.customer.present? %>
                      <p class="text-sm font-semibold text-gray-900">
                        👤 <%= order.customer.full_name %>
                      </p>
                      <% if order.customer.phone.present? %>
                        <p class="text-xs text-gray-600">
                          📞 <%= order.customer.phone %>
                        </p>
                      <% end %>
                    <% else %>
                      <p class="text-xs text-gray-500 italic">Cliente genérico</p>
                    <% end %>
                  </div>
                </div>
              </div>
              
              <div class="flex justify-between items-center pt-3 border-t border-gray-200">
                <div>
                  <p class="text-xs text-gray-500">Total</p>
                  <p class="text-lg font-bold text-indigo-600">
                    <%= number_to_currency(order.total_amount, unit: "₲s. ", precision: 0, delimiter: '.') %>
                  </p>
                </div>
                <button 
                  type="button"
                  data-order-id="<%= order.id %>"
                  data-controller="order-search"
                  data-action="click->order-search#loadToCart"
                  class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium shadow-sm">
                  Cargar al POS
                </button>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-8 text-gray-500">
            Nada para mostrar..
          </div>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>