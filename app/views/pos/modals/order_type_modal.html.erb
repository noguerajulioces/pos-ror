<turbo-frame id="order_type_modal">
  <div class="p-4" data-controller="order-type" 
       data-order-type-tables-url-value="<%= pos_modals_tables_path %>"
       data-order-type-is-mesero-value="<%= current_user.has_role?(:mesero) %>"
       data-order-type-is-mobile-value="<%= mobile_device? %>">
    <% if current_user.has_role?(:mesero) && mobile_device? %>
      <!-- Para meseros en mobile: solo mostrar selección de mesa -->
      <div class="mb-4">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 text-center">Seleccionar Mesa</h3>
        <div id="table-selection-container" data-order-type-target="tableContainer">
          <label class="block text-base font-medium text-gray-700 mb-3">
            Mesa
          </label>
          <select id="table-select" class="block p-3 w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base" data-order-type-target="tableSelect">
            <option value="">-- Seleccione una mesa --</option>
          </select>
        </div>
      </div>
    <% else %>
      <!-- Para otros usuarios o desktop: mostrar opciones de tipo de pedido -->
      <div class="grid grid-cols-2 gap-4 mb-4">    
        <button data-action="order-type#selectType" data-order-type="delivery" class="p-4 border rounded-md hover:bg-gray-50 flex flex-col items-center transition-colors">
          <svg class="w-8 h-8 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium">Delivery</span>
        </button>
        
        <button data-action="order-type#selectType" data-order-type="in_store" class="p-4 border rounded-md hover:bg-gray-50 flex flex-col items-center transition-colors">
          <svg class="w-8 h-8 text-indigo-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span class="font-medium">En el local</span>
        </button>
      </div>
      
      <div id="table-selection-container" class="hidden" data-order-type-target="tableContainer">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Seleccionar Mesa
        </label>
        <select id="table-select" class="block p-2 m-2 w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" data-order-type-target="tableSelect">
          <option value="">-- Seleccione una mesa --</option>
        </select>
      </div>
    <% end %>
  </div>
</turbo-frame>