<!-- Columna Derecha -->
<div class="transition-all duration-300 ease-in-out overflow-hidden w-full md:w-2/4" 
      data-layout-target="rightColumn">
  <div class="bg-white rounded shadow p-2 md:p-4 h-full flex flex-col">
    <!-- Buscador -->
    <div class="mb-4">
      <div class="flex" data-controller="product-search">
        <input type="text" 
                placeholder="Buscar productos..." 
                class="flex-grow px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                data-action="input->product-search#search"
                data-product-search-target="query"
                autofocus />
        <button class="bg-indigo-500 hover:bg-indigo-600 text-white px-3 py-2 rounded-r-md border border-indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 flex items-center"
                data-action="click->product-search#search">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </div>
    </div>
    
    <h2 class="text-lg font-semibold mb-3">Inicio</h2>
    <hr>
    <div class="text-gray-600 mt-2">
      <!-- Search results container (initially hidden) -->
      <div id="search-results-container" class="mt-4 hidden">
        <div class="flex items-center mb-2">
          <button id="back-to-categories-from-search" class="text-indigo-600 hover:text-indigo-800 mr-2"
                  data-controller="product-search" 
                  data-action="click->product-search#clearSearch">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <h3 class="text-lg font-medium">Resultados de búsqueda</h3>
        </div>
        <div class="flex flex-wrap overflow-y-auto max-h-[calc(100vh-250px)] pr-2" id="search-results-list">
          <!-- Search results will be loaded here -->
        </div>
      </div>

      <% if @categories.present? %>
        <div class="flex flex-wrap border border-dotted border-gray-300 rounded-md" id="categories-container">
          <% if @categories.present? %>
            <% @categories.each_with_index do |category, index| %>
              <% 
                # Mobile: 2 columns - border right except last column of row (odd index)
                # Desktop: 3 columns - border right except last column of row (index % 3 == 2)
                mobile_border_r = (index % 2 != 1) ? 'border-r border-dotted border-gray-300' : ''
                desktop_border_r = (index % 3 != 2) ? 'md:border-r md:border-dotted md:border-gray-300' : ''
                
                # Calculate rows for mobile (2 cols) and desktop (3 cols)
                mobile_row = index / 2
                desktop_row = index / 3
                total_mobile_rows = (@categories.length.to_f / 2).ceil
                total_desktop_rows = (@categories.length.to_f / 3).ceil
                
                # Border bottom: show except in last row
                # For mobile: check if this is not the last row (compare with total rows)
                # For desktop: check if this is not the last row
                mobile_border_b = (mobile_row < total_mobile_rows - 1) ? 'border-b border-dotted border-gray-300' : ''
                desktop_border_b = (desktop_row < total_desktop_rows - 1) ? 'md:border-b md:border-dotted md:border-gray-300' : ''
              %>
              <div class="w-1/2 md:w-1/3 p-4 md:p-3 flex flex-col items-center <%= mobile_border_r %> <%= desktop_border_r %> <%= mobile_border_b %> <%= desktop_border_b %>"
                    data-controller="category"
                    data-action="click->category#showSubcategories"
                    data-category-id-value="<%= category.id %>"
                    data-category-name-value="<%= category.name %>">
                <div class="w-16 h-16 md:w-12 md:h-12 bg-indigo-100 rounded-full flex items-center justify-center mb-2 md:mb-2 cursor-pointer">
                  <span class="text-indigo-600 font-bold text-lg md:text-base"><%= category.name.first.upcase %></span>
                </div>
                <span class="text-sm md:text-sm font-medium cursor-pointer text-center"><%= category.name %></span>
              </div>
            <% end %>
            
            <% # Fill remaining cells with empty boxes to maintain grid - only for desktop (3 columns) %>
            <% # In mobile (2 columns) we don't need to fill if there's an even number of items %>
            <% remaining_cells_desktop = (3 - (@categories.length % 3)) % 3 %>
            <% remaining_cells_desktop.times do |i| %>
              <% 
                # Desktop: border right except last column
                desktop_border_r = (i % 3 != 2 && i < remaining_cells_desktop) ? 'md:border-r md:border-dotted md:border-gray-300' : ''
              %>
              <div class="hidden md:flex w-1/3 p-3 flex-col items-center <%= desktop_border_r %>">
                <div class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mb-2 opacity-30">
                  <span class="text-gray-400 font-bold">+</span>
                </div>
                <span class="text-sm font-medium text-gray-300">Nueva categoría</span>
              </div>
            <% end %>
          <% else %>
            <!-- Existing empty state code -->
          <% end %>
        </div>
        
        <!-- Subcategories container (initially hidden) -->
        <div id="subcategories-container" class="mt-4 hidden">
          <div class="flex items-center mb-2">
            <button id="back-to-categories" class="text-indigo-600 hover:text-indigo-800 mr-2"
                    data-controller="category" 
                    data-action="click->category#backToCategories">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            <h3 class="text-lg font-medium" id="selected-category-name"></h3>
          </div>
          <div class="flex flex-wrap border border-dotted border-gray-300 rounded-md" id="subcategories-list">
            <!-- Subcategories will be loaded here -->
          </div>
        </div>
        
        <!-- Products container (initially hidden) - MOVED HERE FROM OUTSIDE -->
        <div id="products-container" class="mt-4 hidden">
          <div class="flex items-center mb-2">
            <button id="back-to-subcategories" class="text-indigo-600 hover:text-indigo-800 mr-2"
                    data-controller="category" 
                    data-action="click->category#backToSubcategories">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            <h3 class="text-lg font-medium" id="selected-product-category"></h3>
          </div>
          <div class="flex flex-wrap overflow-y-auto max-h-[calc(100vh-250px)] pr-2" id="products-list">
            <!-- Products will be loaded here -->
          </div>
        </div>
      <% else %>
        <p>Parece que no hay productos o categorías. ¿Qué tal si empiezas creándolos primero?</p>
      <% end %>
    </div>
  </div>
</div>