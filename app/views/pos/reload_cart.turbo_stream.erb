<%= turbo_stream.replace "cart-items" do %>
  <%= render 'pos/main/cart_items' %>
<% end %>

<%= turbo_stream.replace "cart-actions" do %>
  <div id="cart-actions">
    <%
      is_mesero      = current_user.has_role?(:mesero)
      has_open_order = session[:on_hold_order_id].present?
      grid_cols = if is_mesero && has_open_order
        'grid-cols-2 md:grid-cols-4'
      elsif is_mesero
        'grid-cols-1 md:grid-cols-3'
      elsif has_open_order
        'grid-cols-2 md:grid-cols-5'
      else
        'grid-cols-2 md:grid-cols-4'
      end
    %>
    <div class="mt-2 mb-32 md:mb-0 grid <%= grid_cols %> gap-3 md:gap-0">
      <% unless is_mesero %>
      <button class="bg-green-500 hover:bg-green-600 text-white py-4 font-semibold border-r border-green-600 focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="modal"
              data-action="modal#open"
              data-modal-title="Procesar Pago"
              data-modal-size="max-w-4xl w-full"
              data-modal-frame-id="payment_modal"
              data-modal-frame-src="<%= pos_modals_payment_path %>">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        Pagar
      </button>
      <% end %>
      <% if has_open_order %>
      <button class="bg-blue-500 hover:bg-blue-600 text-white py-4 font-semibold border-r border-blue-600 focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="order"
              data-action="order#createOnHold">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
        </svg>
        <span>Actualizar</span>
      </button>
      <button class="bg-orange-500 hover:bg-orange-600 text-white py-4 font-semibold border-r border-orange-600 focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="order"
              data-action="order#createAndPrint">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
        </svg>
        <span class="leading-tight text-center">Imprimir Cocina</span>
      </button>
      <% else %>
      <button class="bg-blue-500 hover:bg-blue-600 text-white py-4 font-semibold border-r border-blue-600 focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="order"
              data-action="order#createOnHold">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
        </svg>
        <span>Abrir Cuenta</span>
      </button>
      <% end %>
      <button class="bg-white hover:bg-gray-100 text-gray-700 py-4 font-semibold border-r border-gray-300 focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="modal"
              data-action="modal#open"
              data-modal-title="Asignar Delivery"
              data-modal-size="max-w-md w-full"
              data-modal-frame-id="delivery_modal"
              data-modal-frame-src="<%= pos_modals_deliveries_path %>">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Delivery
      </button>
      <button class="bg-red-500 hover:bg-red-600 text-white py-4 font-semibold focus:outline-none flex items-center justify-center text-base min-h-[52px] md:min-h-0"
              data-controller="refresh"
              data-action="refresh#reload">
        <svg class="w-6 h-6 md:w-5 md:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        Anular
      </button>
    </div>
  </div>
<% end %>
