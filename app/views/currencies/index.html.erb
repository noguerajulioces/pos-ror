<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Monedas</h1>
      <p class="mt-1 text-sm text-gray-500">Monedas y tipos de cambio disponibles en el sistema.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_currency_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 inline-flex items-center gap-x-1.5" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nueva moneda
      <% end %>
    </div>
  </div>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="mt-6 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Moneda</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Código</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Símbolo</th>
                <th scope="col" class="px-3 py-3.5 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Tipo de cambio</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">POS</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% if @currencies.empty? %>
                <tr>
                  <td colspan="6" class="py-16 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <p class="mt-3 text-sm font-medium text-gray-900">Sin monedas</p>
                    <p class="mt-1 text-sm text-gray-500">No hay monedas registradas todavía.</p>
                  </td>
                </tr>
              <% else %>
                <% @currencies.each do |currency| %>
                  <tr class="hover:bg-gray-50 transition-colors duration-100">

                    <%# Moneda: bandera + nombre %>
                    <td class="py-3 pl-4 pr-3 sm:pl-6">
                      <div class="flex items-center gap-x-3">
                        <% if currency.flag_url.present? %>
                          <img src="<%= currency.flag_url %>" alt="<%= currency.name %>" class="h-5 w-7 rounded-sm object-cover shadow-sm flex-shrink-0">
                        <% else %>
                          <div class="h-5 w-7 rounded-sm bg-gray-200 flex-shrink-0"></div>
                        <% end %>
                        <p class="text-sm font-medium text-gray-900"><%= currency.name %></p>
                      </div>
                    </td>

                    <%# Código %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700 font-mono">
                        <%= currency.code %>
                      </span>
                    </td>

                    <%# Símbolo %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm font-medium text-gray-700">
                      <%= currency.symbol %>
                    </td>

                    <%# Tipo de cambio %>
                    <td class="whitespace-nowrap px-3 py-3 text-right text-sm font-semibold text-gray-900">
                      <%= number_with_delimiter(currency.exchange_rate, delimiter: '.') %>
                    </td>

                    <%# Visible en POS %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <% if currency.display? %>
                        <span class="inline-flex items-center gap-x-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">
                          <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                          Visible
                        </span>
                      <% else %>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">
                          Oculto
                        </span>
                      <% end %>
                    </td>

                    <%# Acciones %>
                    <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-6">
                      <div class="flex items-center justify-end gap-x-2">
                        <%= link_to edit_currency_path(currency),
                            title: "Editar moneda",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                          </svg>
                        <% end %>

                        <% if currency.display? %>
                          <%= link_to toggle_display_currency_path(currency),
                              data: { turbo_method: :patch, turbo_confirm: "¿Ocultar esta moneda del POS?" },
                              title: "Ocultar del POS",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-orange-600 shadow-sm ring-1 ring-inset ring-orange-200 hover:bg-orange-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                          <% end %>
                        <% else %>
                          <%= link_to toggle_display_currency_path(currency),
                              data: { turbo_method: :patch, turbo_confirm: "¿Mostrar esta moneda en el POS?" },
                              title: "Mostrar en POS",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-green-600 shadow-sm ring-1 ring-inset ring-green-200 hover:bg-green-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                          <% end %>
                        <% end %>
                      </div>
                    </td>

                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% if @currencies.respond_to?(:total_pages) %>
    <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
      <%= will_paginate @currencies, renderer: TailwindPaginateRenderer %>
    </div>
  <% end %>

</div>
