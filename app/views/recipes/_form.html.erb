<%= form_with(model: product,
    url: product.persisted? ? recipe_path(product) : recipes_path,
    method: product.persisted? ? :patch : :post,
    local: true) do |form| %>

  <%# ── Errores ─────────────────────────────────────────────── %>
  <% if product.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4">
      <div class="flex gap-3">
        <svg class="h-5 w-5 text-red-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <div>
          <p class="text-sm font-medium text-red-800"><%= product.errors.count %> error(es) impiden guardar:</p>
          <ul class="mt-1 list-disc pl-4 text-sm text-red-700 space-y-0.5">
            <% product.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Layout principal (2 columnas) ─────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">

    <%# ── Columna izquierda (2/3) ────────────────────────── %>
    <div class="lg:col-span-2 space-y-6">

      <%# Identificación %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6"
           data-controller="sku-generator" data-sku-generator-prefix-value="RECIPE">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Identificación</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" do %>
              Nombre de la receta <span class="text-red-500">*</span>
            <% end %>
            <%= form.text_field :name,
                placeholder: "Ej: Pizza Margarita",
                data: {
                  sku_generator_target: "nameField",
                  action: "input->sku-generator#updateButtonState"
                },
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :sku, "SKU", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="flex">
              <%= form.text_field :sku,
                  placeholder: "RECIPE-001",
                  data: { sku_generator_target: "skuField" },
                  class: "block w-full rounded-l-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm" %>
              <button type="button"
                      data-action="click->sku-generator#generateSku"
                      data-sku-generator-target="button"
                      title="Generar SKU automático"
                      class="inline-flex items-center gap-1 px-3 py-2 border border-l-0 border-gray-300 bg-gray-50 text-gray-500 text-xs rounded-r-lg hover:bg-gray-100 whitespace-nowrap">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Auto
              </button>
            </div>
          </div>

          <div data-controller="number-format">
            <%= form.label :price, class: "block text-sm font-medium text-gray-700 mb-1" do %>
              Precio de venta <span class="text-red-500">*</span>
            <% end %>
            <div class="relative flex rounded-lg ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-indigo-500">
              <span class="inline-flex items-center px-3 text-gray-500 text-sm bg-gray-50 rounded-l-lg border-r border-gray-300">₲s.</span>
              <%= form.text_field :price,
                  data: { number_format_target: "input" },
                  value: (product.price.present? ? product.price.to_i : nil),
                  placeholder: "0",
                  class: "block w-full border-0 bg-transparent px-3 py-2.5 text-gray-900 placeholder:text-gray-400 focus:ring-0 sm:text-sm text-right rounded-r-lg" %>
            </div>
          </div>
        </div>
      </div>

      <%# Stock info %>
      <div class="bg-amber-50 rounded-xl ring-1 ring-amber-200 p-5">
        <div class="flex gap-3">
          <svg class="h-5 w-5 text-amber-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="text-sm font-medium text-amber-800">Stock calculado automáticamente</p>
            <p class="text-sm text-amber-700 mt-0.5">El stock disponible de esta receta se determina por la disponibilidad de sus ingredientes, no se gestiona de forma directa.</p>
          </div>
        </div>
      </div>

      <%# Descripción %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Descripción</h2>
        <%= form.text_area :description,
            rows: 4,
            placeholder: "Describe la receta (opcional)...",
            class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm resize-none" %>
      </div>

    </div><%# /columna izquierda %>

    <%# ── Columna derecha (1/3) ────────────────────────────── %>
    <div class="space-y-6">

      <%# Imagen %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6" data-controller="image-preview">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Imagen</h2>
        <div class="flex flex-col items-center">
          <div class="w-full aspect-square max-w-[200px] bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden mb-3" data-image-preview-target="preview">
            <% if product.images.any? { |pi| pi.image.attached? } %>
              <%= image_tag product.images.first.image.variant(resize_to_fill: [300, 300]),
                    alt: "Imagen de la receta",
                    class: "w-full h-full object-cover" %>
            <% else %>
              <div data-image-preview-target="svg" class="text-center p-4">
                <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="mt-1 text-xs text-gray-400">Sin imagen</p>
              </div>
            <% end %>
          </div>
          <label for="recipe_image"
                 class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Subir imagen
          </label>
          <%= form.file_field :image,
              accept: "image/png,image/jpeg",
              direct_upload: true,
              id: "recipe_image",
              data: {
                action: "change->image-preview#previewImage",
                image_preview_target: "input"
              },
              class: "sr-only" %>
          <p class="mt-1.5 text-xs text-gray-400">PNG o JPG, máx. 10 MB</p>
        </div>
      </div>

      <%# Organización %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Organización</h2>
        <div class="space-y-4">

          <%= render 'shared/category_select', form: form %>

          <div>
            <%= form.label :unit_id, "Unidad de medida", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="relative">
              <%= form.collection_select :unit_id, Unit.all, :id, :name,
                  { prompt: "Selecciona unidad" },
                  { class: "block w-full rounded-lg border-0 px-3 pr-8 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 sm:text-sm appearance-none" } %>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5">
                <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>

          <div>
            <span class="block text-sm font-medium text-gray-700 mb-2">Estado</span>
            <div class="grid grid-cols-2 gap-2">
              <label class="relative flex cursor-pointer">
                <%= form.radio_button :status, 'active', class: "sr-only peer" %>
                <span class="w-full text-center rounded-lg px-3 py-2 text-sm font-medium ring-1 ring-inset ring-gray-200 text-gray-600 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:ring-green-300 hover:bg-gray-50 transition-colors">
                  Activo
                </span>
              </label>
              <label class="relative flex cursor-pointer">
                <%= form.radio_button :status, 'inactive', class: "sr-only peer" %>
                <span class="w-full text-center rounded-lg px-3 py-2 text-sm font-medium ring-1 ring-inset ring-gray-200 text-gray-600 peer-checked:bg-red-50 peer-checked:text-red-700 peer-checked:ring-red-300 hover:bg-gray-50 transition-colors">
                  Inactivo
                </span>
              </label>
            </div>
          </div>

        </div>
      </div>

    </div><%# /columna derecha %>
  </div><%# /grid %>

  <%# ── Ingredientes (ancho completo) ──────────────────────── %>
  <div class="mt-6 bg-white rounded-xl shadow-sm ring-1 ring-gray-200"
       data-controller="recipe-form"
       data-recipe-form-index-value="<%= product.persisted? ? product.recipe_components.count : 1 %>">
    <div class="p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Ingredientes</h2>
          <p class="text-xs text-gray-400 mt-0.5">Definí qué ingredientes y qué cantidades componen esta receta</p>
        </div>
        <button type="button"
                data-recipe-form-target="addButton"
                data-action="click->recipe-form#addIngredient"
                class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Agregar
        </button>
      </div>

      <div data-recipe-form-target="container"
           data-action="click->recipe-form#removeIngredient"
           class="space-y-2">
        <% if product.persisted? && product.recipe_components.any? %>
          <% product.recipe_components.each_with_index do |component, index| %>
            <%= render 'recipe_component_fields', f: form, component: component, index: index, ingredients: @available_ingredients %>
          <% end %>
        <% else %>
          <%= render 'recipe_component_fields', f: form, component: nil, index: 0, ingredients: @available_ingredients %>
        <% end %>
      </div>

      <div class="mt-4 flex gap-2 p-3 bg-blue-50 rounded-lg">
        <svg class="h-4 w-4 text-blue-400 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
        <p class="text-xs text-blue-700">El stock se calcula en base a la disponibilidad de los ingredientes. Agregá al menos un ingrediente para que la receta esté disponible.</p>
      </div>
    </div>

    <template data-recipe-form-target="template">
      <%= render 'recipe_component_fields', f: nil, component: nil, index: '__INDEX__', ingredients: @available_ingredients, is_template: true %>
    </template>
  </div>

  <%# ── Acciones ────────────────────────────────────────────── %>
  <div class="mt-6 flex items-center justify-end gap-3 pb-8">
    <%= link_to product.persisted? ? recipe_path(product) : recipes_path,
        class: "rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
      Cancelar
    <% end %>
    <%= form.submit product.persisted? ? "Guardar cambios" : "Crear receta",
        class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>

<% end %>
