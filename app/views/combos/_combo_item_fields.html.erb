<% is_template = local_assigns[:is_template] || false %>
<% item_id = item&.id %>

<div class="combo-component-item bg-gray-50 rounded-lg p-4 mb-4 border border-gray-200" 
     data-controller="product-info">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
    
    <!-- Campo hidden para ID si existe -->
    <% if item_id && !is_template %>
      <input type="hidden" name="combo_items[<%= index %>][id]" value="<%= item_id %>">
    <% end %>

    <!-- Selector de Producto -->
    <div class="md:col-span-6">
      <label class="block text-sm font-medium text-gray-700 mb-1">
        Producto <span class="text-red-500">*</span>
      </label>
      <% if is_template %>
        <select name="combo_items[__INDEX__][component_product_id]" 
                class="product-selector py-2 px-3 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                data-product-info-target="selector"
                data-action="change->product-info#updateProductInfo"
                required>
          <option value="">Selecciona un producto...</option>
          <% products.each do |product| %>
            <option value="<%= product.id %>" 
                    data-product-name="<%= product.name %>"
                    data-product-price="<%= product.price %>"
                    data-product-stock="<%= product.virtual_stock %>"
                    data-product-unit="<%= product.unit&.abbreviation || 'unidad' %>"
                    data-product-category="<%= product.category.name %>">
              <%= product.name %> - <%= product.category.name %>
            </option>
          <% end %>
        </select>
      <% else %>
        <select name="combo_items[<%= index %>][component_product_id]" 
                class="product-selector py-2 px-3 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                data-product-info-target="selector"
                data-action="change->product-info#updateProductInfo"
                required>
          <option value="">Selecciona un producto...</option>
          <% products.each do |product| %>
            <option value="<%= product.id %>" 
                    data-product-name="<%= product.name %>"
                    data-product-price="<%= product.price %>"
                    data-product-stock="<%= product.virtual_stock %>"
                    data-product-unit="<%= product.unit&.abbreviation || 'unidad' %>"
                    data-product-category="<%= product.category.name %>"
                    <%= 'selected' if item&.component_product_id == product.id %>>
              <%= product.name %> - <%= product.category.name %>
            </option>
          <% end %>
        </select>
      <% end %>
    </div>

    <!-- Cantidad -->
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-gray-700 mb-1">
        Cantidad <span class="text-red-500">*</span>
      </label>
      <% if is_template %>
        <input type="number" 
               name="combo_items[__INDEX__][quantity]" 
               min="1" 
               step="1" 
               value="1"
               class="block w-full py-2 px-3 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-right"
               data-product-info-target="quantityInput"
               data-action="input->product-info#updateQuantity"
               required>
      <% else %>
        <input type="number" 
               name="combo_items[<%= index %>][quantity]" 
               min="1" 
               step="1" 
               value="<%= item&.quantity || 1 %>"
               class="block w-full py-2 px-3 mr-2 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-right"
               data-product-info-target="quantityInput"
               data-action="input->product-info#updateQuantity"
               required>
      <% end %>
    </div>

    <!-- Opcional -->
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-gray-700 mb-1">Opcional</label>
      <div class="flex items-center h-10">
        <% if is_template %>
          <input type="hidden" name="combo_items[__INDEX__][optional]" value="0">
          <input type="checkbox" 
                 name="combo_items[__INDEX__][optional]" 
                 value="1"
                 class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
        <% else %>
          <input type="hidden" name="combo_items[<%= index %>][optional]" value="0">
          <input type="checkbox" 
                 name="combo_items[<%= index %>][optional]" 
                 value="1"
                 <%= 'checked' if item&.optional? %>
                 class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
        <% end %>
        <span class="ml-2 text-sm text-gray-500">¿Opcional?</span>
      </div>
    </div>

    <!-- Botón Eliminar -->
    <div class="md:col-span-2">
      <button type="button" 
              class="remove-component-btn w-full inline-flex justify-center items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
        <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        Eliminar
      </button>
    </div>
  </div>

  <!-- Información adicional del producto seleccionado -->
  <div class="mt-3 p-3 bg-white rounded border border-gray-100" 
       data-product-info-target="infoContainer">
    
    <!-- Estado inicial: sin producto seleccionado -->
    <div class="flex items-center text-sm text-gray-600" 
         data-product-info-target="noProductSelected">
      <svg class="h-4 w-4 mr-1 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>Selecciona un producto para ver su información de stock y precio</span>
    </div>
    
    <!-- Información del producto (inicialmente oculta) -->
    <div class="hidden" data-product-info-target="productDetails">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        <div class="text-center">
          <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Precio</div>
          <div class="font-semibold text-green-600" data-product-info-target="productPrice">-</div>
        </div>
        <div class="text-center">
          <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Stock</div>
          <div class="font-semibold" data-product-info-target="productStock">-</div>
        </div>
        <div class="text-center">
          <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Unidad</div>
          <div class="font-medium text-gray-700" data-product-info-target="productUnit">-</div>
        </div>
        <div class="text-center">
          <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Categoría</div>
          <div class="font-medium text-gray-700" data-product-info-target="productCategory">-</div>
        </div>
      </div>
      
      <!-- Alerta de stock bajo -->
      <div class="hidden mt-3 p-2 bg-yellow-50 border border-yellow-200 rounded-md" 
           data-product-info-target="stockWarning">
        <div class="flex items-center text-sm text-yellow-800">
          <svg class="h-4 w-4 mr-1 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
          <span data-product-info-target="stockWarningText">Stock insuficiente para la cantidad solicitada</span>
        </div>
      </div>
      
      <!-- Alerta de sin stock -->
      <div class="hidden mt-3 p-2 bg-red-50 border border-red-200 rounded-md" 
           data-product-info-target="noStockWarning">
        <div class="flex items-center text-sm text-red-800">
          <svg class="h-4 w-4 mr-1 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Este producto no tiene stock disponible</span>
        </div>
      </div>
    </div>
  </div>
</div>
