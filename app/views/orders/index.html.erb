<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900">Órdenes</h1>
      <p class="mt-2 text-sm text-gray-700">Lista de todas las órdenes registradas.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%#= link_to "Nueva Orden", new_order_path, class: "block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  </div>

  <%= search_form_for @q, class: "mt-8 mb-4" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="px-4 py-6 sm:p-8">
        <!-- Primera fila: Cliente, Tipo de Orden y Usuario Delivery -->
        <div class="mb-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-4">
            <div>
              <%= f.label :id_as_string_or_customer_document_or_customer_first_name_or_customer_last_name_cont, "Buscar Orden o Cliente", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <%= f.search_field :id_as_string_or_customer_document_or_customer_first_name_or_customer_last_name_cont, 
                  placeholder: "Número de orden, documento, nombre o apellido del cliente",
                  class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>

            <div>
              <%= f.label :order_type_eq, "Tipo de Orden", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <%= f.select :order_type_eq, 
                  options_for_select([
                    ['Todos los tipos', ''],
                    ['En Tienda', 'in_store'],
                    ['Delivery', 'delivery']
                  ], params.dig(:q, :order_type_eq)), 
                  {}, 
                  class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>

            <div>
              <%= f.label :delivery_user_id_eq, "Usuario Delivery", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <%= f.select :delivery_user_id_eq, 
                  options_for_select([['Todos los usuarios', '']] + @delivery_users.map { |user| [user.name, user.id] }, params.dig(:q, :delivery_user_id_eq)), 
                  {}, 
                  class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>
          </div>
        </div>

        <!-- Filtros por Fecha -->
        <div class="mb-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <%= f.label :order_date_gteq, "Fecha desde", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <%= f.date_field :order_date_gteq, 
                  class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>

            <div>
              <%= f.label :order_date_lteq, "Fecha hasta", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <%= f.date_field :order_date_lteq, 
                  class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-x-3 border-t border-gray-900/10 px-4 py-4 sm:px-8">
        <%= f.submit "Buscar", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        <%= link_to "Limpiar", orders_path, class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-2 pl-4 pr-3 text-left text-xs font-semibold text-gray-900 sm:pl-6">Orden</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-gray-900">Cliente</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-gray-900">Total</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-gray-900">Estado</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-gray-900">Delivery</th>
                <th scope="col" class="relative py-2 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @orders.each do |order| %>
                <tr class="hover:bg-gray-50">
                  <td class="whitespace-nowrap py-2 pl-4 pr-3 text-sm sm:pl-6">
                    <div class="flex flex-col">
                      <span class="font-medium text-gray-900">#0<%= order.id %></span>
                      <span class="text-xs text-gray-500"><%= order.order_date.strftime("%d/%m/%Y %H:%M") %></span>
                    </div>
                  </td>
                  <td class="px-3 py-2">
                    <div class="flex flex-col">
                      <span class="text-sm text-gray-900"><%= order.customer&.full_name || "Cliente Genérico" %></span>
                      <span class="text-xs text-gray-500"><%= order.payment_method.name %></span>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2">
                    <div class="flex flex-col">
                      <span class="text-sm font-semibold text-gray-900">₲s. <%= number_with_delimiter(order.total_amount.to_i, delimiter: '.') %></span>
                      <span class="text-xs text-gray-500">
                        <% if order.order_type == 'delivery' %>
                          <span class="inline-flex items-center text-orange-600">
                            <svg class="w-3 h-3 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Delivery
                          </span>
                        <% else %>
                          <span class="text-blue-600">En Tienda</span>
                        <% end %>
                      </span>
                    </div>
                  </td>
                  <td class="px-3 py-2">
                    <% status_class = case order.status 
                       when Order::STATUSES[:completed] then "text-green-600 bg-green-100"
                       when Order::STATUSES[:on_hold] then "text-yellow-600 bg-yellow-100"
                       when Order::STATUSES[:cancelled] then "text-red-600 bg-red-100"
                       end %>
                    <span class="<%= status_class %> inline-flex rounded-full px-2 text-xs font-semibold leading-5">
                      <%= order.status == "completed" ? "Completado" : 
                          order.status == "on_hold" ? "En Espera" : 
                          order.status == "cancelled" ? "Cancelado" : order.status %>
                    </span>
                  </td>
                  <td class="px-3 py-2">
                    <% if order.order_type == 'delivery' %>
                      <% if order.delivery_user.present? %>
                        <div class="flex items-center">
                          <div class="flex-shrink-0 h-5 w-5">
                            <div class="h-5 w-5 rounded-full bg-orange-500 flex items-center justify-center">
                              <span class="text-xs font-medium text-white">
                                <%= order.delivery_user.name.first.upcase %>
                              </span>
                            </div>
                          </div>
                          <span class="ml-1.5 text-xs text-gray-600"><%= order.delivery_user.name %></span>
                        </div>
                      <% elsif order.status != 'cancelled' && current_user.has_role?(:superadmin) %>
                        <%= select_tag "delivery_user_#{order.id}", 
                            options_from_collection_for_select(@delivery_users, :id, :name, order.delivery_user_id),
                            { prompt: "Asignar", 
                              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-xs py-1",
                              data: { 
                                controller: "order-delivery",
                                action: "change->order-delivery#assign",
                                order_id: order.id
                              }
                            } %>
                      <% else %>
                        <span class="text-gray-400 text-xs">-</span>
                      <% end %>
                    <% elsif order.order_type == 'in_store' && order.table.present? %>
                      <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                        <%= order.table.name %>
                      </span>
                    <% else %>
                      <span class="text-gray-400 text-xs">-</span>
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-2 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <div class="flex justify-end space-x-1">
                      <%= link_to order_path(order), class: "text-indigo-600 hover:text-indigo-900", title: "Ver" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                      <% end %>
                      <%= link_to print_preview_order_path(order), target: "_blank", class: "text-indigo-600 hover:text-green-900", title: "Imprimir" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                        </svg>
                      <% end %>
                      <% if current_user.has_role?(:superadmin) %>
                        <% if order.status != "cancelled" %>
                          <%= link_to order_path(order), 
                              data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro?" }, 
                              class: "text-red-600 hover:text-red-900", title: "Cancelar" do %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                          <% end %>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<% if @orders.respond_to?(:total_pages) %>
  <div class="mt-4 justify-center border-t flex">
    <%= will_paginate @orders, renderer: TailwindPaginateRenderer %>
  </div>
<% end %>