<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Órdenes</h1>
      <p class="mt-1 text-sm text-gray-500">Historial de todas las órdenes registradas.</p>
    </div>
  </div>

  <%# ── Search form ─────────────────────────────────────────────────────── %>
  <%= search_form_for @q, url: orders_path, class: "mt-6" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-4">
          <div>
            <%= f.label :id_as_string_or_customer_document_or_customer_first_name_or_customer_last_name_cont,
                "Orden / Cliente", class: "block text-sm font-medium text-gray-900" %>
            <%= f.search_field :id_as_string_or_customer_document_or_customer_first_name_or_customer_last_name_cont,
                placeholder: "Nº orden, documento, nombre…",
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :order_type_eq, "Tipo de orden", class: "block text-sm font-medium text-gray-900" %>
            <%= f.select :order_type_eq,
                options_for_select([
                  ['Todos los tipos', ''],
                  ['En Tienda', 'in_store'],
                  ['Delivery', 'delivery']
                ], params.dig(:q, :order_type_eq)),
                {},
                class: "mt-1 block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :delivery_user_id_eq, "Usuario delivery", class: "block text-sm font-medium text-gray-900" %>
            <%= f.select :delivery_user_id_eq,
                options_for_select([['Todos los usuarios', '']] + @delivery_users.map { |u| [u.name, u.id] }, params.dig(:q, :delivery_user_id_eq)),
                {},
                class: "mt-1 block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
          <div>
            <%= f.label :order_date_gteq, "Fecha desde", class: "block text-sm font-medium text-gray-900" %>
            <%= f.date_field :order_date_gteq,
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :order_date_lteq, "Fecha hasta", class: "block text-sm font-medium text-gray-900" %>
            <%= f.date_field :order_date_lteq,
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-x-3 border-t border-gray-900/10 px-4 py-3 sm:px-6">
        <%= f.submit "Buscar",
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <%= link_to "Limpiar", orders_path,
            class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="mt-6 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Orden</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Cliente</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Total</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Tipo</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Estado</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Creado por</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Delivery / Mesa</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% if @orders.empty? %>
                <tr>
                  <td colspan="8" class="py-16 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" />
                    </svg>
                    <p class="mt-3 text-sm font-medium text-gray-900">Sin resultados</p>
                    <p class="mt-1 text-sm text-gray-500">No se encontraron órdenes con los filtros aplicados.</p>
                    <%= link_to "Limpiar filtros", orders_path, class: "mt-4 inline-block text-sm text-indigo-600 hover:text-indigo-500 underline" %>
                  </td>
                </tr>
              <% else %>
                <% @orders.each do |order| %>
                  <tr class="hover:bg-gray-50 transition-colors duration-100">

                    <%# Orden: nº + fecha %>
                    <td class="whitespace-nowrap py-3 pl-4 pr-3 sm:pl-6">
                      <span class="block text-sm font-semibold text-gray-900">#<%= order.id.to_s.rjust(4, '0') %></span>
                      <span class="block text-xs text-gray-400 mt-0.5"><%= order.order_date.strftime("%d/%m/%Y %H:%M") %></span>
                    </td>

                    <%# Cliente + método de pago %>
                    <td class="px-3 py-3">
                      <span class="block text-sm text-gray-900"><%= order.customer&.full_name || "Cliente genérico" %></span>
                      <span class="block text-xs text-gray-400 mt-0.5"><%= order.display_payment_method %></span>
                    </td>

                    <%# Total %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <span class="text-sm font-semibold text-gray-900">
                        ₲ <%= number_with_delimiter(order.total_amount.to_i, delimiter: '.') %>
                      </span>
                    </td>

                    <%# Tipo de orden %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <% if order.order_type == 'delivery' %>
                        <span class="inline-flex items-center gap-x-1 rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-700">
                          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                          </svg>
                          Delivery
                        </span>
                      <% else %>
                        <span class="inline-flex items-center gap-x-1 rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">
                          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
                          </svg>
                          En tienda
                        </span>
                      <% end %>
                    </td>

                    <%# Estado %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <% status_classes = case order.status
                         when 'completed'      then 'bg-green-100 text-green-700'
                         when 'on_hold'        then 'bg-yellow-100 text-yellow-700'
                         when 'cancelled'      then 'bg-red-100 text-red-700'
                         when 'pending_payment' then 'bg-orange-100 text-orange-700'
                         else 'bg-gray-100 text-gray-600'
                         end %>
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= status_classes %>">
                        <%= case order.status
                            when 'completed'       then 'Completado'
                            when 'on_hold'         then 'Cuenta abierta'
                            when 'cancelled'       then 'Cancelado'
                            when 'pending_payment' then 'Pago pendiente'
                            else order.status
                            end %>
                      </span>
                    </td>

                    <%# Creado por %>
                    <td class="whitespace-nowrap px-3 py-3">
                      <div class="flex items-center gap-x-2">
                        <div class="h-6 w-6 rounded-full bg-indigo-500 flex items-center justify-center flex-shrink-0">
                          <span class="text-xs font-medium text-white"><%= order.user.name.first.upcase %></span>
                        </div>
                        <span class="text-xs text-gray-600"><%= order.user.name %></span>
                      </div>
                    </td>

                    <%# Delivery / Mesa %>
                    <td class="px-3 py-3">
                      <% if order.order_type == 'delivery' %>
                        <% if order.delivery_user.present? %>
                          <div class="flex items-center gap-x-2">
                            <div class="h-6 w-6 rounded-full bg-orange-500 flex items-center justify-center flex-shrink-0">
                              <span class="text-xs font-medium text-white"><%= order.delivery_user.name.first.upcase %></span>
                            </div>
                            <span class="text-xs text-gray-600"><%= order.delivery_user.name %></span>
                          </div>
                        <% elsif order.status != 'cancelled' && current_user.has_role?(:superadmin) %>
                          <%= select_tag "delivery_user_#{order.id}",
                              options_from_collection_for_select(@delivery_users, :id, :name, order.delivery_user_id),
                              prompt: "Asignar…",
                              class: "block w-full rounded-md border-0 py-1 text-xs text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500",
                              data: {
                                controller: "order-delivery",
                                action: "change->order-delivery#assign",
                                order_id: order.id
                              } %>
                        <% else %>
                          <span class="text-gray-300 text-xs">—</span>
                        <% end %>
                      <% elsif order.order_type == 'in_store' && order.table.present? %>
                        <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                          <%= order.table.name %>
                        </span>
                      <% else %>
                        <span class="text-gray-300 text-xs">—</span>
                      <% end %>
                    </td>

                    <%# Acciones %>
                    <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-6">
                      <div class="flex items-center justify-end gap-x-2">
                        <%= link_to order_path(order),
                            title: "Ver orden",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                          </svg>
                        <% end %>

                        <%= link_to print_preview_order_path(order),
                            title: "Imprimir",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50",
                            data: {
                              controller: "print",
                              action: "click->print#print",
                              print_url_value: print_preview_order_path(order)
                            } do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
                          </svg>
                        <% end %>

                        <% if current_user.has_role?(:superadmin) && order.status != 'cancelled' %>
                          <%= link_to order_path(order),
                              data: { turbo_method: :delete, turbo_confirm: "¿Cancelar esta orden?" },
                              title: "Cancelar orden",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                          <% end %>
                        <% end %>
                      </div>
                    </td>

                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────── %>
  <% if @orders.respond_to?(:total_pages) %>
    <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
      <%= will_paginate @orders, renderer: TailwindPaginateRenderer %>
    </div>
  <% end %>

</div>
