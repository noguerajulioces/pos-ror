<div class="receipt">
  <div class="center bold">
    <%= Setting.get('company_name').to_s %>
  </div>
  <div class="center">
    <%= Setting.get('company_owner').to_s %>
  </div>
  <div class="center">
    <%= Setting.get('company_address').to_s %>
  </div>
  <div class="center">
    RUC: <%= Setting.get('company_ruc') %>
  </div>
  <div class="center">
    <%= Setting.get('company_phone') %>
  </div>

  <div class="separator"></div>

  <div class="center bold">
    RECIBO DE DINERO
  </div>

  <div class="separator"></div>
  <div class="center">
    Actividad Económica:
  </div>
  <div class="center">
    <%= Setting.get('company_economic_activity').to_s %>
  </div>

  <div class="separator"></div>
  <div>Fecha: <%= @order.order_date.strftime("%d/%m/%Y") %></div>
  <div>Hora: <%= @order.order_date.strftime("%H:%M") %></div>

  <div class="separator"></div>
  <div>CI/RUC: <%= @order&.customer&.document || "00000000000" %></div>
  <div>Cliente: <%= @order&.customer&.full_name || "Cliente Genérico" %></div>

  <div class="separator"></div>
  <div class="bold">CANT. DESCRIPCION           TOTAL</div>
  <div class="separator"></div>

  <% @order.order_items.each do |item| %>
    <div class="item-line">
      <span><%= item.quantity %> <%= item.product.name.truncate(20) %></span>
      <span>₲s. <%= number_with_delimiter((item.quantity * item.price).to_i, delimiter: '.') %></span>
    </div>
  <% end %>

  <div class="separator"></div>
  <% 
    # Calculate subtotal from order items
    items_subtotal = @order.order_items.sum(&:subtotal)
    calculated_discount = items_subtotal - @order.total_amount + (@order.delivery_amount || 0)
  %>
  <% if calculated_discount > 0 %>
    <div class="item-line">
      <span>Subtotal:</span>
      <span>₲s. <%= number_with_delimiter(items_subtotal.to_i, delimiter: '.') %></span>
    </div>
    <div class="item-line">
      <span>Descuento:</span>
      <span>₲s. <%= number_with_delimiter(calculated_discount.to_i, delimiter: '.') %></span>
    </div>
    <div class="separator"></div>
  <% end %>
  
  <% if @order.delivery_amount && @order.delivery_amount > 0 %>
    <div class="item-line">
      <span>Delivery:</span>
      <span>₲s. <%= number_with_delimiter(@order.delivery_amount.to_i, delimiter: '.') %></span>
    </div>
    <div class="separator"></div>
  <% end %>
  
  <div class="item-line bold">
    <span>Total a Abonar:</span>
    <span>₲s. <%= number_with_delimiter(@order.total_amount.to_i, delimiter: '.') %></span>
  </div>
  <div class="separator"></div>
  <div class="item-line">
    <span>Total Grav. 10%:</span>
    <span>₲s. <%= number_with_delimiter((@order.total_amount * 0.1).to_i, delimiter: '.') %></span>
  </div>
  <div class="separator"></div>

  <div>Condición: <%= @order.status == 'pending_payment' ? 'Crédito' : 'Contado' %></div>
  <div>Forma de pago: <%= @order.payment_method&.name %></div>

  <% if @order.status == 'pending_payment' %>
    <div class="separator"></div>
    <div class="item-line">
      <span>Total Pagado:</span>
      <span>₲s. <%= number_with_delimiter(@order.total_paid.to_i, delimiter: '.') %></span>
    </div>
    <div class="item-line bold">
      <span>Saldo Pendiente:</span>
      <span>₲s. <%= number_with_delimiter(@order.outstanding_balance.to_i, delimiter: '.') %></span>
    </div>
  <% end %>

  <div class="separator"></div>
  <div>Cajero/a: <%= @order.user.name %></div>
  <div>Fecha impresión: <%= Time.zone.now.strftime('%d/%m/%Y %H:%M') %></div>

  <% Currency.where(display: true).each do |currency| %>
    <div><%= currency.name %> (<%= currency.symbol %>): <%= number_with_delimiter(currency.exchange_rate.to_i, delimiter: '.') %></div>
  <% end %>
  
  <div class="center" style="margin-top: 20px;">
    <small>¡Gracias por su compra!</small>
  </div>
</div>
