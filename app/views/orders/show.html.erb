<% paid_amount   = @order.order_payments.sum(:amount).to_f
   total_amount  = @order.total_amount.to_f
   paid_percent  = total_amount > 0 ? [[paid_amount / total_amount * 100, 0].max, 100].min.round : 0
   subtotal      = @order.order_items.sum(:subtotal).to_f
   delivery_amt  = @order.delivery_amount.to_f
   discount_amt  = if @order.discount_percentage.present? && @order.discount_percentage > 0
                     subtotal * @order.discount_percentage / 100
                   else
                     [subtotal - (total_amount - delivery_amt), 0].max
                   end %>

<div class="mx-auto px-2 sm:px-6 py-6 space-y-5">

  <%# Flash %>
  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-2 py-3 rounded text-sm" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <%# ── Header ── %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold text-gray-900">Orden #<%= @order.id %></h1>
        <% status_class = case @order.status
           when Order::STATUSES[:completed]      then "bg-green-100 text-green-700"
           when Order::STATUSES[:on_hold]        then "bg-yellow-100 text-yellow-700"
           when Order::STATUSES[:cancelled]      then "bg-red-100 text-red-700"
           when Order::STATUSES[:pending_payment] then "bg-orange-100 text-orange-700"
           end %>
        <span class="<%= status_class %> text-xs font-medium px-2 py-0.5 rounded-full">
          <%= @order.status == "completed"       ? "Completado"    :
              @order.status == "on_hold"         ? "Cuenta Abierta" :
              @order.status == "cancelled"       ? "Cancelado"     :
              @order.status == "pending_payment" ? "Pago Pendiente" : @order.status %>
        </span>
      </div>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= @order.order_date.strftime("%d/%m/%Y %H:%M") %> &middot; <%= @order.user.name || @order.user.email %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to print_preview_order_path(@order),
          class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50",
          data: { controller: "print", action: "click->print#print", print_url_value: print_preview_order_path(@order) } do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
        </svg>
        Imprimir
      <% end %>

      <% if @order.status != "cancelled" %>
        <%= link_to edit_order_path(@order),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
          </svg>
          Editar
        <% end %>
      <% end %>

      <% if current_user.has_role?(:superadmin) && @order.status != "cancelled" %>
        <%= link_to order_path(@order),
            data: { turbo_method: :delete, turbo_confirm: "¿Cancelar esta orden?" },
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-red-600 bg-white border border-red-300 rounded-md hover:bg-red-50" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
          Cancelar orden
        <% end %>
      <% end %>

      <%= link_to orders_path,
          class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
        </svg>
        Volver
      <% end %>
    </div>
  </div>

  <%# ── Info + Resumen ── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

    <%# Información %>
    <div class="bg-white border border-gray-200 rounded-lg">
      <div class="px-5 py-3 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Información</h2>
      </div>
      <dl class="px-5 py-4 grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
        <div>
          <dt class="text-gray-500">Cliente</dt>
          <dd class="mt-0.5 text-gray-900 font-medium"><%= @order.customer&.full_name || "Cliente Genérico" %></dd>
        </div>
        <div>
          <dt class="text-gray-500">Tipo</dt>
          <dd class="mt-0.5 text-gray-900 font-medium">
            <%= @order.order_type == "in_store" ? "En Tienda" : "Delivery" %>
            <% if @order.order_type == "in_store" && @order.table.present? %>
              <span class="ml-1 text-xs text-indigo-600 font-normal">(<%= @order.table.name %>)</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-gray-500">Método de pago</dt>
          <dd class="mt-0.5 text-gray-900 font-medium"><%= @order.display_payment_method %></dd>
        </div>
        <% if @order.receipt_number.present? %>
          <div>
            <dt class="text-gray-500">N° Recibo</dt>
            <dd class="mt-0.5 text-gray-900 font-medium"><%= @order.receipt_number %></dd>
          </div>
        <% end %>
      </dl>
      <% if @order.notes.present? %>
        <div class="px-5 py-3 border-t border-gray-100 text-sm text-gray-600">
          <span class="font-medium text-gray-500">Notas: </span><%= @order.notes %>
        </div>
      <% end %>
    </div>

    <%# Resumen financiero %>
    <div class="bg-white border border-gray-200 rounded-lg">
      <div class="px-5 py-3 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Resumen</h2>
      </div>
      <dl class="px-5 py-4 space-y-3 text-sm">
        <div class="flex justify-between text-gray-600">
          <dt>Subtotal</dt>
          <dd>₲s. <%= number_with_delimiter(subtotal.to_i, delimiter: '.') %></dd>
        </div>

        <% if discount_amt > 0 %>
          <div class="flex justify-between text-gray-600">
            <dt>
              Descuento
              <% if @order.discount_percentage.present? && @order.discount_percentage > 0 %>
                (<%= @order.discount_percentage %>%)
              <% end %>
              <% if @order.discount_reason.present? %>
                <span class="block text-xs text-gray-400 italic"><%= @order.discount_reason %></span>
              <% end %>
            </dt>
            <dd class="text-red-600">-₲s. <%= number_with_delimiter(discount_amt.to_i, delimiter: '.') %></dd>
          </div>
        <% end %>

        <% if delivery_amt > 0 %>
          <div class="flex justify-between text-gray-600">
            <dt>
              Delivery
              <% if @order.delivery_user.present? %>
                <span class="block text-xs text-gray-400"><%= @order.delivery_user.name %></span>
              <% end %>
            </dt>
            <dd>+₲s. <%= number_with_delimiter(delivery_amt.to_i, delimiter: '.') %></dd>
          </div>
        <% end %>

        <div class="flex justify-between pt-3 border-t border-gray-100 font-semibold text-gray-900">
          <dt>Total</dt>
          <dd>₲s. <%= number_with_delimiter(total_amount.to_i, delimiter: '.') %></dd>
        </div>
      </dl>
    </div>
  </div>

  <%# ── Productos ── %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">Productos</h2>
    </div>
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
          <th class="px-5 py-2 text-left font-medium">Producto</th>
          <th class="px-5 py-2 text-right font-medium">Precio</th>
          <th class="px-5 py-2 text-right font-medium">Cantidad</th>
          <th class="px-5 py-2 text-right font-medium">Subtotal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @order_items.each do |item| %>
          <tr class="text-gray-700">
            <td class="px-5 py-3 font-medium text-gray-900"><%= item.product.name %></td>
            <td class="px-5 py-3 text-right">₲s. <%= number_with_delimiter(item.price.to_i, delimiter: '.') %></td>
            <td class="px-5 py-3 text-right"><%= item.quantity %> <%= item.product&.unit&.abbreviation %></td>
            <td class="px-5 py-3 text-right">₲s. <%= number_with_delimiter(item.subtotal.to_i, delimiter: '.') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagos ── %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700">Pagos</h2>
      <% if @order.status != "cancelled" && @order.outstanding_balance > 0 && @order.order_payments.any? %>
        <%= link_to new_order_payment_path(order_id: @order.id),
            title: "Registrar pago",
            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
          </svg>
        <% end %>
      <% end %>
    </div>

    <% if @order.order_payments.any? %>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Fecha</th>
            <th class="px-5 py-2 text-left font-medium">Método</th>
            <th class="px-5 py-2 text-left font-medium">Referencia</th>
            <th class="px-5 py-2 text-right font-medium">Monto</th>
            <th class="px-5 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @order.order_payments.order(payment_date: :desc).each do |payment| %>
            <tr class="text-gray-700">
              <td class="px-5 py-3"><%= payment.payment_date&.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="px-5 py-3"><%= payment.payment_method&.name %></td>
              <td class="px-5 py-3 text-gray-400"><%= payment.reference_number.presence || "—" %></td>
              <td class="px-5 py-3 text-right font-medium text-gray-900">₲s. <%= number_with_delimiter(payment.amount.to_i, delimiter: '.') %></td>
              <td class="px-5 py-3 text-right">
                <% if current_user.has_role?(:superadmin) %>
                  <%= link_to order_payment_path(payment),
                      data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este pago?" },
                      title: "Eliminar pago",
                      class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%# Totales + progress bar %>
      <div class="px-5 py-4 border-t border-gray-100 space-y-3">
        <div class="w-full bg-gray-100 rounded-full h-1.5">
          <div class="<%= paid_percent >= 100 ? 'bg-green-500' : 'bg-indigo-500' %> h-1.5 rounded-full" style="width: <%= paid_percent %>%"></div>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Pagado <span class="font-medium text-gray-700">₲s. <%= number_with_delimiter(paid_amount.to_i, delimiter: '.') %></span></span>
          <span class="<%= @order.outstanding_balance > 0 ? 'text-red-600' : 'text-green-600' %> font-medium">
            Saldo ₲s. <%= number_with_delimiter(@order.outstanding_balance.to_i, delimiter: '.') %>
          </span>
        </div>
      </div>

    <% else %>
      <div class="px-5 py-8 text-center text-sm text-gray-400 flex flex-col items-center gap-3">
        Sin pagos registrados.
        <% if @order.status != "cancelled" %>
          <%= link_to new_order_payment_path(order_id: @order.id),
              title: "Registrar pago",
              class: "inline-flex items-center gap-1.5 rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
            </svg>
            Registrar pago
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
