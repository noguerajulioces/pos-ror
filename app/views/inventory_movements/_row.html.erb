<tr class="animate-fade-in-down">
  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-900 sm:pl-0">
    <%= l(movement.created_at, format: :short) %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-700">
    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium 
      <%= case movement.movement_type
          when 'purchase' then 'bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20'
          when 'sale' then 'bg-purple-50 text-purple-700 ring-1 ring-inset ring-purple-600/20'
          when 'adjustment' then 'bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20'
          when 'return' then 'bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20'
          when 'transfer' then 'bg-gray-50 text-gray-700 ring-1 ring-inset ring-gray-600/20'
          end %>">
      <%= case movement.movement_type
          when 'purchase' then 'Compra'
          when 'sale' then 'Venta'
          when 'adjustment' then 'Ajuste'
          when 'return' then 'Devolución'
          when 'transfer' then 'Transferencia'
          else movement.movement_type.humanize
          end %>
    </span>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm font-medium <%= movement.quantity >= 0 ? 'text-green-600' : 'text-red-600' %>">
    <%= movement.quantity >= 0 ? '+' : '' %><%= movement.quantity %> <%= item.unit&.abbreviation %>
  </td>
  <td class="px-3 py-4 text-sm text-gray-700">
    <%= movement.reason.present? ? movement.reason : '-' %>
  </td>
  <td class="whitespace-nowrap px-3 py-4 text-sm font-semibold text-gray-900">
    <%= movement.final_stock %> <%= item.unit&.abbreviation %>
  </td>
</tr>
