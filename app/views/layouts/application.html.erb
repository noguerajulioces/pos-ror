<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "Kombi Burger - POS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Kombi Burger">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#FFFFFF">
    <meta name="msapplication-TileColor" content="#FFFFFF">
    <meta name="msapplication-navbutton-color" content="#FFFFFF">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps %>
    <link rel="manifest" href="/manifest.json">

    <link rel="icon" href="/logo.jpg" type="image/jpeg">
    <link rel="apple-touch-icon" href="/logo.jpg">
    <link rel="shortcut icon" href="/logo.jpg" type="image/jpeg">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div data-controller="sidebar sidebar-collapse">
      <%= render 'layouts/shared/sidebar' %>

      <div class="lg:pl-72 transition-all duration-300 main-content-expanded" data-sidebar-collapse-target="mainContent">
        <%= render 'layouts/shared/navbar' %>

        <main class="py-10">
          <div class="w-full">
            <div class="fixed top-50 left-0 right-0 z-50">
              <%= render 'layouts/shared/notice' %>
            </div>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
    
    <!-- Container para flash messages dinámicos -->
    <div id="flash_messages" class="fixed top-4 right-4 z-50 w-full max-w-md space-y-2 pointer-events-none px-4 sm:px-0"></div>
  </body>
  <turbo-frame id="modal">
  </turbo-frame>
</html>
