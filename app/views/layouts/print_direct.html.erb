<!DOCTYPE html>
<html>
  <head>
    <title>Recibo - Orden #<%= @order.id %></title>
    <meta name="viewport" content="width=80mm, initial-scale=1.0, maximum-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <style>
      /* Estilos base para pantalla - simular apariencia térmica */
      body {
        font-family: 'Courier New', 'Courier', monospace;
        font-size: 11px;
        line-height: 1.3;
        margin: 0;
        padding: 10px;
        background: #f5f5f5;
      }
      
      .receipt {
        max-width: 300px;
        margin: 0 auto;
        background: white;
        padding: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
      }
      
      /* Estilos de texto */
      .center { 
        text-align: center; 
        line-height: 1.2;
      }
      .right { text-align: right; }
      .bold { 
        font-weight: bold; 
        font-size: 12px;
      }
      
      /* Encabezado de empresa más grande */
      .receipt > .center:first-child {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 2px;
      }
      
      /* Separadores más marcados */
      .separator {
        border-top: 1px dashed #000;
        margin: 4px 0;
        height: 0;
      }
      
      /* Líneas de items ajustadas */
      .item-line {
        display: flex;
        justify-content: space-between;
        margin: 1px 0;
        font-size: 10px;
      }
      
      .item-line.bold {
        font-size: 11px;
        font-weight: bold;
        margin: 3px 0;
      }
      
      @media print {
        @page {
          size: 80mm auto;
          margin: 0;
        }

        body {
          width: 80mm;
          margin: 0;
          padding: 0;
          background: white;
        }

        .receipt {
          box-sizing: border-box;
          width: 80mm;
          max-width: 80mm;
          margin: 0;
          padding: 2mm;
          box-shadow: none;
        }
        
        /* Tamaños de fuente específicos para térmica */
        body {
          font-size: 10px;
        }
        
        .bold {
          font-size: 11px;
        }
        
        .receipt > .center:first-child {
          font-size: 13px;
        }
        
        /* Separadores en impresión */
        .separator {
          border-top: 1px dashed #000;
          margin: 3px 0;
        }
        
        .item-line {
          font-size: 9px;
          margin: 0.5px 0;
        }
        
        .item-line.bold {
          font-size: 10px;
          margin: 2px 0;
        }
        
        /* Monocromático y nítido para térmicas */
        * {
          color: #000 !important;
          background: #fff !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
          -webkit-font-smoothing: none;
          font-smooth: never;
          text-rendering: optimizeSpeed;
        }
        
        /* Evitar saltos de página */
        .item-line, .separator {
          page-break-inside: avoid;
        }
        
        /* Espaciado compacto */
        .center, div {
          line-height: 1.2;
        }
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
