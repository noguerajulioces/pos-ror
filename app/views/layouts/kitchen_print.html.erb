<!DOCTYPE html>
<html>
  <head>
    <title>Cocina</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Courier New', monospace;
        font-size: 16px;
        line-height: 1.5;
        background: white;
        width: 72mm;
        margin: 0 auto;
      }

      .ticket {
        width: 72mm;
        padding: 3mm 2mm;
      }

      .header {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 3px;
        border-bottom: 3px solid #000;
        padding-bottom: 5px;
        margin-bottom: 8px;
      }

      .meta {
        font-size: 14px;
        margin-bottom: 8px;
      }

      .meta-line {
        display: flex;
        justify-content: space-between;
        padding: 2px 0;
      }

      .separator {
        border-top: 2px dashed #000;
        margin: 8px 0;
      }

      .items-title {
        font-size: 13px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
      }

      .item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 18px;
        font-weight: bold;
        padding: 5px 0;
        border-bottom: 1px dashed #000;
      }

      .item-name {
        flex: 1;
        padding-right: 4mm;
        word-break: break-word;
      }

      .item-qty {
        font-size: 22px;
        font-weight: bold;
        min-width: 12mm;
        text-align: right;
        white-space: nowrap;
      }

      @media print {
        html, body { width: 72mm; }
        .ticket { padding: 2mm 1mm; }
        @page {
          margin: 0;
          size: 80mm auto;
        }
      }
    </style>
  </head>
  <body onload="window.print()">
    <%= yield %>
  </body>
</html>
