<!DOCTYPE html>
<html>
  <head>
    <title>Cocina</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Courier New', monospace;
        font-size: 14px;
        line-height: 1.4;
        background: white;
        width: 80mm;
      }

      .ticket {
        width: 80mm;
        padding: 4mm;
      }

      .header {
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        letter-spacing: 2px;
        border-bottom: 2px solid #000;
        padding-bottom: 4px;
        margin-bottom: 6px;
      }

      .meta {
        font-size: 12px;
        margin-bottom: 6px;
      }

      .meta-line {
        display: flex;
        justify-content: space-between;
      }

      .separator {
        border-top: 1px dashed #000;
        margin: 6px 0;
      }

      .items-title {
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 4px;
      }

      .item {
        display: flex;
        justify-content: space-between;
        font-size: 15px;
        font-weight: bold;
        padding: 3px 0;
        border-bottom: 1px dotted #ccc;
      }

      .item-name { flex: 1; }

      .item-qty {
        font-size: 18px;
        font-weight: bold;
        min-width: 30px;
        text-align: right;
      }

      @media print {
        body { width: 80mm; }
        .ticket { padding: 2mm; }
        @page { margin: 0; size: 80mm auto; }
      }
    </style>
  </head>
  <body onload="window.print()">
    <%= yield %>
  </body>
</html>
