<!-- Mobile sidebar -->
<div class="relative z-50 lg:hidden" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-gray-900/80 hidden" aria-hidden="true" data-sidebar-target="backdrop" data-action="click->sidebar#hideSidebar"></div>
  <div
    class="fixed inset-0 flex transform -translate-x-full transition ease-in-out duration-300"
    data-sidebar-target="sidebar"
    >
    <div class="relative mr-16 flex w-full max-w-xs flex-1">
      <div class="absolute left-full top-0 flex w-16 justify-center pt-5">
        <button type="button" class="-m-2.5 p-2.5" data-action="sidebar#hideSidebar">
          <span class="sr-only">Close sidebar</span>
          <svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Sidebar component for mobile -->
      <div class="flex grow flex-col gap-y-5 overflow-y-auto bg-white px-6 pb-4">
        <div class="flex h-16 shrink-0 items-center justify-center">
          <span class="h-8 w-auto font-bold text-lg text-indigo-800">POS Sistema</span>
          <span><%= current_user.account.name %></span>
        </div>
        <nav class="flex flex-1 flex-col">
          <ul role="list" class="flex flex-1 flex-col gap-y-7">
            <li>
              <ul role="list" class="-mx-2 space-y-1">
                <%= SidebarPresenter.new(self).render_items %>
              </ul>
            </li>
            <% if current_user.has_role?(:superadmin) %>
              <li class="mt-auto">
                <a href="<%= edit_settings_path %>" class="group -mx-2 flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold text-gray-700 hover:bg-gray-50 hover:text-indigo-600">
                  <svg class="size-6 shrink-0 text-gray-400 group-hover:text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c..."/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                  </svg>
                  Configuraciones
                </a>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>

<!-- Static sidebar for desktop -->
<div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col transition-all duration-300 ease-in-out" 
     data-sidebar-collapse-target="sidebar">
  <!-- Sidebar component for desktop -->
  <div class="flex grow flex-col gap-y-6 overflow-y-auto border-r border-gray-200 bg-gradient-to-b from-white to-gray-50 px-6 pb-6 shadow-lg sidebar-scroll">
    <!-- Header with toggle button -->
    <div class="flex flex-col h-20 shrink-0 items-center justify-center relative">
      <div class="flex items-center justify-between w-full">
        <div class="flex flex-col items-center" data-sidebar-collapse-target="content">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-lg flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l-1-3m1 3l-1-3m-16.5-3h9v1.5H3.75z" />
              </svg>
            </div>
            <span class="h-8 w-auto font-bold text-lg text-indigo-600">POS Sistema</span>
          </div>
          <span class="w-auto font-semibold text-xs text-gray-500 mt-1"><%= current_user.account.name %></span>
        </div>
        <!-- Toggle button -->
        <button type="button" 
                class="group p-2.5 rounded-xl text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 transform hover:scale-110 shadow-sm hover:shadow-md relative z-10"
                data-action="click->sidebar-collapse#toggle"
                data-sidebar-collapse-target="toggleButton"
                title="Colapsar sidebar">
          <svg class="size-5 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
      </div>
    </div>
    <nav class="flex flex-1 flex-col">
      <ul role="list" class="flex flex-1 flex-col gap-y-6">
        <li>
          <ul role="list" class="-mx-2 space-y-2">
            <%= SidebarPresenter.new(self, collapsed: sidebar_collapsed?).render_items %>
          </ul>
        </li>
        <% if current_user.has_role?(:superadmin) %>
          <li class="mt-auto">
            <%= render_settings_icon(collapsed: sidebar_collapsed?, is_current: current_page?(edit_settings_path)) %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>