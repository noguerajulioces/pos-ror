<!doctype html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; color: #333; }
    .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #4f46e5; padding-bottom: 10px; }
    .header h1 { color: #4f46e5; margin: 0; }
    .header p { color: #6b7280; font-size: 14px; margin-top: 5px; }
    
    .stats-grid { width: 100%; margin-bottom: 30px; }
    .stat-box { 
      padding: 10px;
      border: 1px solid #e5e7eb;
      border-radius: 4px;
      display: inline-block;
      width: 30%;
      text-align: center;
    }
    .stat-label { color: #6b7280; font-size: 12px; font-weight: bold; text-transform: uppercase; }
    .stat-value { font-size: 16px; font-weight: bold; margin-top: 5px; }
    .text-red { color: #dc2626; }
    .text-green { color: #059669; }
    
    table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 12px; }
    th { 
      background-color: #f9fafb;
      color: #374151;
      padding: 10px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
      font-weight: bold;
    }
    td { 
      padding: 10px;
      border-bottom: 1px solid #f3f4f6;
    }
    .text-right { text-align: right; }
    .font-bold { font-weight: bold; }
    
    .footer { margin-top: 30px; text-align: right; font-size: 10px; color: #9ca3af; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Reporte de Créditos / Fiado</h1>
    <p>Generado el <%= l(Time.current, format: :long) %></p>
  </div>

  <table class="stats-grid">
    <tr>
      <td style="border: none; padding: 0;">
        <div class="stat-box" style="width: 90%;">
          <div class="stat-label">Total Créditos</div>
          <div class="stat-value"><%= number_to_currency(@total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %></div>
        </div>
      </td>
      <td style="border: none; padding: 0;">
        <div class="stat-box" style="width: 90%;">
          <div class="stat-label">Total Cobrado</div>
          <div class="stat-value text-green"><%= number_to_currency(@total_paid, unit: 'Gs. ', precision: 0, delimiter: '.') %></div>
        </div>
      </td>
      <td style="border: none; padding: 0;">
        <div class="stat-box" style="width: 90%;">
          <div class="stat-label">Total Pendiente</div>
          <div class="stat-value text-red"><%= number_to_currency(@total_outstanding, unit: 'Gs. ', precision: 0, delimiter: '.') %></div>
        </div>
      </td>
    </tr>
  </table>

  <table>
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Orden #</th>
        <th>Cliente</th>
        <th>Vendedor</th>
        <th class="text-right">Total</th>
        <th class="text-right">Pagado</th>
        <th class="text-right">Pendiente</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= l(order.order_date.to_date, format: :default) %></td>
          <td>#<%= order.id %></td>
          <td><%= order.customer&.name || "N/A" %></td>
          <td><%= order.user.name %></td>
          <td class="text-right"><%= number_to_currency(order.total_amount, unit: '', precision: 0, delimiter: '.') %></td>
          <td class="text-right text-green"><%= number_to_currency(order.total_paid, unit: '', precision: 0, delimiter: '.') %></td>
          <td class="text-right text-red font-bold"><%= number_to_currency(order.outstanding_balance, unit: '', precision: 0, delimiter: '.') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="footer">
    POS System - Página 1
  </div>
</body>
</html>
