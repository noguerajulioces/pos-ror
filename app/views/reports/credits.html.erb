<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Cuentas por Cobrar (Fiado)</h1>
      <p class="mt-1 text-sm text-gray-500">Gestión de saldos pendientes</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
      <%= link_to credits_reports_path(q: params[:q], format: :csv), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        CSV
      <% end %>
      <%= link_to credits_reports_path(q: params[:q], format: :pdf), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        PDF
      <% end %>
      <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Imprimir
      </button>
    </div>
  </div>

  <!-- Filtros -->
  <div class="mt-6 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Filtros</p>
    </div>
    <div class="px-5 py-4">
      <%= search_form_for @q, url: credits_reports_path do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm text-gray-500 mb-1">Desde</label>
            <%= f.date_field :order_date_gteq, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Hasta</label>
            <%= f.date_field :order_date_lteq, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Cliente</label>
            <%= f.select :customer_id_eq, Customer.all.map { |c| [c.full_name, c.id] }, { include_blank: 'Todos' }, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div class="flex items-end gap-2">
            <button type="submit" class="px-4 py-1.5 bg-indigo-600 text-sm font-medium text-white rounded-md hover:bg-indigo-700">
              Filtrar
            </button>
            <%= link_to credits_reports_path, class: "px-4 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
              Limpiar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Resumen -->
  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Cuentas por Cobrar</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_currency(@total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Cobrado</p>
      <p class="mt-1 text-sm font-medium text-green-600">
        <%= number_to_currency(@total_paid, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Pendiente</p>
      <p class="mt-1 text-sm font-medium text-red-600">
        <%= number_to_currency(@total_outstanding, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
  </div>

  <!-- Listado -->
  <div class="mt-5 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
      <p class="text-sm font-semibold text-gray-700">Listado de Órdenes Pendientes</p>
      <% if @orders_paginated.any? %>
        <span class="text-xs text-gray-400">
          Mostrando <%= @orders_paginated.offset + 1 %>–<%= @orders_paginated.offset + @orders_paginated.length %> de <%= @orders_paginated.total_entries %>
        </span>
      <% end %>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Fecha</th>
            <th class="px-5 py-2 text-left font-medium">Orden #</th>
            <th class="px-5 py-2 text-left font-medium">Cliente</th>
            <th class="px-5 py-2 text-left font-medium">Vendedor</th>
            <th class="px-5 py-2 text-right font-medium">Total</th>
            <th class="px-5 py-2 text-right font-medium">Pagado</th>
            <th class="px-5 py-2 text-right font-medium">Pendiente</th>
            <th class="px-5 py-2 text-center font-medium">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @orders_paginated.any? %>
            <% @orders_paginated.each do |order| %>
              <tr class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
                <td class="px-5 py-3 whitespace-nowrap">
                  <%= l(order.order_date, format: :short) %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap font-medium text-indigo-600">
                  #<%= order.id %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-gray-900">
                  <%= order.customer&.full_name || "N/A" %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                  <%= order.user.name %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right font-medium text-gray-900">
                  <%= number_to_currency(order.total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right text-green-600">
                  <%= number_to_currency(order.total_paid, unit: 'Gs. ', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right font-medium text-red-600">
                  <%= number_to_currency(order.outstanding_balance, unit: 'Gs. ', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-center">
                  <%= link_to order_path(order), title: "Ver Detalle", class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-5 py-8 text-center text-sm text-gray-500">
                No se encontraron créditos pendientes
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 flex justify-center">
    <%= will_paginate @orders_paginated, renderer: TailwindPaginateRenderer %>
  </div>
</div>
