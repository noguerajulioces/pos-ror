<div class="px-4 sm:px-6 lg:px-8 py-6 bg-gray-50 min-h-screen">
  <div class="sm:flex sm:items-center sm:justify-between pb-4 border-b border-gray-200">
    <h1 class="text-xl font-bold text-gray-800 flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2 text-indigo-600">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M9 3.75H6.75a1.5 1.5 0 00-1.5 1.5v2.25m10.5-3.75H18a1.5 1.5 0 011.5 1.5v2.25" />
      </svg>
      Cuentas por Cobrar (Fiado)
    </h1>
    
    <div class="mt-4 sm:mt-0 flex space-x-2">
      <%= link_to credits_reports_path(q: params[:q], format: :csv), class: "inline-flex items-center px-3 py-1.5 bg-white border border-gray-300 rounded-md font-medium text-sm text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        CSV
      <% end %>
      
      <%= link_to credits_reports_path(q: params[:q], format: :pdf), class: "inline-flex items-center px-3 py-1.5 bg-white border border-gray-300 rounded-md font-medium text-sm text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        PDF
      <% end %>

      <button onclick="window.print()" class="inline-flex items-center px-3 py-1.5 bg-gray-100 border border-gray-300 rounded-md font-medium text-sm text-gray-700 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Imprimir
      </button>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white p-4 rounded-lg shadow-sm mb-4 mt-4 border border-gray-200">
    <%= search_form_for @q, url: credits_reports_path do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Desde</label>
          <%= f.date_field :order_date_gteq, class: "w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 text-sm" %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Hasta</label>
          <%= f.date_field :order_date_lteq, class: "w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 text-sm" %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Cliente</label>
          <%= f.select :customer_id_eq, Customer.all.map { |c| [c.full_name, c.id] }, { include_blank: 'Todos' }, class: "w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 text-sm" %>
        </div>
        
        <div class="flex items-end space-x-2">
          <button type="submit" class="flex-1 px-4 py-2 bg-indigo-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            Filtrar
          </button>
          <%= link_to credits_reports_path, class: "px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 flex items-center" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Limpiar
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Resumen -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Total Cuentas por Cobrar</p>
      <p class="text-2xl font-bold text-gray-900">
        <%= number_to_currency(@total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    
    <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Total Cobrado</p>
      <p class="text-2xl font-bold text-green-600">
        <%= number_to_currency(@total_paid, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    
    <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Total Pendiente</p>
      <p class="text-2xl font-bold text-red-600">
        <%= number_to_currency(@total_outstanding, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
  </div>

  <!-- Listado -->
  <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200 flex justify-between items-center bg-gray-50">
      <h2 class="text-base font-medium text-gray-800">Listado de Órdenes Pendientes</h2>
      <% if @orders_paginated.any? %>
        <span class="text-xs font-medium text-gray-500">
          Mostrando <%= @orders_paginated.offset + 1 %> al <%= @orders_paginated.offset + @orders_paginated.length %> de <%= @orders_paginated.total_entries %>
        </span>
      <% end %>
    </div>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-white">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Orden #</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vendedor</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Pagado</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Pendiente</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @orders_paginated.any? %>
            <% @orders_paginated.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                  <%= l(order.order_date, format: :short) %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-indigo-600">
                  #<%= order.id %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                  <%= order.customer&.full_name || "N/A" %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                  <%= order.user.name %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-right font-medium text-gray-900">
                  <%= number_to_currency(order.total_amount, unit: '', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-green-600">
                  <%= number_to_currency(order.total_paid, unit: '', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-right font-bold text-red-600">
                  <%= number_to_currency(order.outstanding_balance, unit: '', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm text-center">
                  <%= link_to order_path(order), class: "text-indigo-600 hover:text-indigo-900", title: "Ver Detalle" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-sm text-gray-500">
                No se encontraron créditos pendientes
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 flex justify-center">
    <%= will_paginate @orders_paginated, renderer: TailwindPaginateRenderer %>
  </div>
</div>
