<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Análisis de Inventario</h1>
      <p class="mt-1 text-sm text-gray-500">Vista general del estado y rendimiento del inventario</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
    </div>
  </div>

  <!-- Métricas clave -->
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Valor del Inventario</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_currency(@inventory_metrics[:total_value], unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Margen Promedio</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_percentage(@inventory_metrics[:average_margin], precision: 1) %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Salud del Inventario</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_percentage(@inventory_metrics[:stock_health], precision: 1) %>
      </p>
      <div class="mt-2 w-full bg-gray-100 rounded-full h-1.5">
        <div class="<%= @inventory_metrics[:stock_health] >= 100 ? 'bg-green-500' : 'bg-indigo-500' %> h-1.5 rounded-full"
             style="width: <%= [[@inventory_metrics[:stock_health], 0].max, 100].min %>%"></div>
      </div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Productos en Alerta</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @stock_status[:low_stock] %></p>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-1 lg:grid-cols-2 gap-5">
    <!-- Distribución por categorías -->
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100">
        <p class="text-sm font-semibold text-gray-700">Distribución por Categorías</p>
      </div>
      <div class="px-5 py-4 space-y-4">
        <% @top_categories.each do |category| %>
          <div>
            <div class="flex justify-between text-sm text-gray-700 mb-1">
              <span class="font-medium text-gray-900"><%= category.name %></span>
              <span class="text-xs text-gray-400"><%= category.products_count %> productos</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-1.5">
              <div class="bg-indigo-500 h-1.5 rounded-full"
                   style="width: <%= number_to_percentage(category.products_count.to_f / @stock_status[:total] * 100, precision: 0) %>"></div>
            </div>
          </div>
        <% end %>
        <p class="text-xs text-gray-400 text-right">Total: <%= @stock_status[:total] %> productos</p>
      </div>
    </div>

    <!-- Rendimiento de ventas -->
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-100">
        <p class="text-sm font-semibold text-gray-700">Rendimiento de Ventas (30 días)</p>
      </div>
      <div class="px-5 py-4">
        <% if @sales_analysis[:top_sellers].any? %>
          <div class="space-y-3">
            <% @sales_analysis[:top_sellers].each_with_index do |product, index| %>
              <div class="flex items-center gap-3">
                <span class="flex-shrink-0 h-6 w-6 rounded-full bg-indigo-100 text-indigo-600 text-xs font-medium flex items-center justify-center">
                  <%= index + 1 %>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate"><%= product.name %></p>
                  <p class="text-xs text-gray-400">SKU: <%= product.sku || 'N/A' %></p>
                </div>
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">
                  <%= product.sales_count %> ventas
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">
            No hay datos de ventas para mostrar en este período
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
