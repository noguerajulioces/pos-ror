<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Reporte de Productos</h1>
      <p class="mt-1 text-sm text-gray-500">Análisis detallado del inventario y rendimiento de productos</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
      <%= link_to products_reports_path(format: :pdf), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        Exportar PDF
      <% end %>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Productos</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @products.count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Bajo Stock</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= @products.where('stock <= min_stock').count %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Productos Activos</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @products.active.count %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Valor Total Inventario</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_currency(@products.sum('stock * average_cost'), unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
  </div>

  <div class="mt-5 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Listado de Productos</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Producto</th>
            <th class="px-5 py-2 text-left font-medium">Categoría</th>
            <th class="px-5 py-2 text-left font-medium">Stock</th>
            <th class="px-5 py-2 text-left font-medium">Precio</th>
            <th class="px-5 py-2 text-left font-medium">Costo Promedio</th>
            <th class="px-5 py-2 text-left font-medium">Margen</th>
            <th class="px-5 py-2 text-left font-medium">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @products.each do |product| %>
            <tr class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
              <td class="px-5 py-3 whitespace-nowrap">
                <div class="font-medium text-gray-900"><%= product.name %></div>
                <div class="text-xs text-gray-400"><%= product.sku %></div>
              </td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                <%= product.category&.name %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="<%= low_stock?(product) ? 'text-red-600 font-medium' : 'text-gray-700' %>">
                  <%= product.stock %> <%= product.unit&.name %>
                </span>
              </td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-900">
                <%= number_to_currency(product.price, unit: 'Gs. ', precision: 0, delimiter: '.') %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-900">
                <%= number_to_currency(product.average_cost, unit: 'Gs. ', precision: 0, delimiter: '.') %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="<%= product.profit_margin_percentage > 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= number_to_percentage(product.profit_margin_percentage, precision: 2) %>
                </span>
              </td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full
                  <%= case product.status
                      when 'active'       then 'bg-green-100 text-green-700'
                      when 'inactive'     then 'bg-red-100 text-red-700'
                      when 'out_of_stock' then 'bg-red-100 text-red-700'
                      end %>">
                  <%= product.status&.humanize %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="mt-4 justify-center border-t flex">
  <%= will_paginate @products, renderer: TailwindPaginateRenderer %>
</div>
