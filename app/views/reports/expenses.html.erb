<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Reporte de Gastos</h1>
      <p class="mt-1 text-sm text-gray-500">Gastos registrados por período y categoría</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
      <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Imprimir
      </button>
    </div>
  </div>

  <!-- Filtros -->
  <div class="mt-6 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Filtros</p>
    </div>
    <div class="px-5 py-4">
      <%= search_form_for @q, url: expenses_reports_path do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm text-gray-500 mb-1">Desde</label>
            <%= f.date_field :expense_date_gteq, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Hasta</label>
            <%= f.date_field :expense_date_lteq, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1">Categoría</label>
            <%= f.select :category_eq, Expense.categories.keys.map { |k| [I18n.t("activerecord.attributes.expense.categories.#{k}", default: k.humanize), k] }, { include_blank: 'Todas' }, class: "w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
          </div>
          <div class="flex items-end gap-2">
            <button type="submit" class="px-4 py-1.5 bg-indigo-600 text-sm font-medium text-white rounded-md hover:bg-indigo-700">
              Filtrar
            </button>
            <%= link_to expenses_reports_path, class: "px-4 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
              Limpiar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Estadísticas -->
  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total de Gastos</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_currency(@total, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Registros</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @expenses.total_entries %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Período</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <% if @q.expense_date_gteq.present? && @q.expense_date_lteq.present? %>
          <%= l(@q.expense_date_gteq, format: :short) %> — <%= l(@q.expense_date_lteq, format: :short) %>
        <% else %>
          Todos
        <% end %>
      </p>
    </div>
  </div>

  <!-- Listado -->
  <div class="mt-5 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
      <p class="text-sm font-semibold text-gray-700">Listado de Gastos</p>
      <% if @expenses.any? %>
        <span class="text-xs text-gray-400">
          Mostrando <%= @expenses.offset + 1 %>–<%= @expenses.offset + @expenses.length %> de <%= @expenses.total_entries %>
        </span>
      <% end %>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Fecha</th>
            <th class="px-5 py-2 text-left font-medium">Categoría</th>
            <th class="px-5 py-2 text-left font-medium">Descripción</th>
            <th class="px-5 py-2 text-left font-medium">Método de Pago</th>
            <th class="px-5 py-2 text-right font-medium">Monto</th>
            <th class="px-5 py-2 text-center font-medium">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if @expenses.any? %>
            <% @expenses.each do |expense| %>
              <tr class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
                <td class="px-5 py-3 whitespace-nowrap">
                  <%= l(expense.expense_date, format: :short) %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= category_badge_class(expense.category) %>">
                    <%= I18n.t("activerecord.attributes.expense.categories.#{expense.category}", default: expense.category.humanize) %>
                  </span>
                </td>
                <td class="px-5 py-3 max-w-xs truncate text-gray-500">
                  <%= expense.description.present? ? expense.description : "—" %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                  <%= expense.payment_method&.name || "—" %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right font-medium text-gray-900">
                  <%= number_to_currency(expense.amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-center">
                  <%= link_to edit_expense_path(expense), title: "Editar", class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-5 py-8 text-center text-sm text-gray-500">
                No se encontraron gastos con los filtros seleccionados
              </td>
            </tr>
          <% end %>
        </tbody>
        <% if @expenses.any? %>
          <tfoot>
            <tr class="border-t border-gray-100 bg-gray-50">
              <td colspan="4" class="px-5 py-3 text-right text-sm text-gray-500">Total:</td>
              <td class="px-5 py-3 text-right text-sm font-medium text-gray-900">
                <%= number_to_currency(@total, unit: 'Gs. ', precision: 0, delimiter: '.') %>
              </td>
              <td></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
  </div>
</div>

<div class="mt-4 justify-center border-t flex">
  <%= will_paginate @expenses, renderer: TailwindPaginateRenderer %>
</div>
