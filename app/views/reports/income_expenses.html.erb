<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Reporte de Ingresos y Gastos</h1>
      <p class="mt-1 text-sm text-gray-500">Resumen financiero del período seleccionado</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
      <%= link_to income_expenses_reports_path(start_date: @start_date, end_date: @end_date, format: :pdf), target: "_blank", class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        PDF
      <% end %>
      <%= link_to income_expenses_reports_path(start_date: @start_date, end_date: @end_date, format: :csv), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        CSV
      <% end %>
    </div>
  </div>

  <!-- Filtro de fechas -->
  <div class="mt-6 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Período</p>
    </div>
    <div class="px-5 py-4">
      <%= form_with url: income_expenses_reports_path, method: :get, class: "flex flex-col sm:flex-row gap-4 items-end" do |f| %>
        <div class="flex-1">
          <%= f.label :start_date, "Fecha inicio", class: "block text-sm text-gray-500 mb-1" %>
          <%= f.date_field :start_date, value: @start_date, class: "block w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
        </div>
        <div class="flex-1">
          <%= f.label :end_date, "Fecha fin", class: "block text-sm text-gray-500 mb-1" %>
          <%= f.date_field :end_date, value: @end_date, class: "block w-full px-3 py-1.5 text-sm rounded-md border border-gray-300 focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
        </div>
        <div>
          <%= f.submit "Filtrar", class: "px-4 py-1.5 bg-indigo-600 text-sm font-medium text-white rounded-md hover:bg-indigo-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Resumen financiero -->
  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Ingresos</p>
      <p class="mt-1 text-sm font-medium text-green-600">
        <%= number_to_currency(@incomes_total, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Gastos</p>
      <p class="mt-1 text-sm font-medium text-red-600">
        <%= number_to_currency(@expenses_total, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Balance Neto</p>
      <p class="mt-1 text-sm font-medium <%= @balance >= 0 ? 'text-indigo-600' : 'text-red-600' %>">
        <%= number_to_currency(@balance, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
  </div>

  <!-- Detalle de movimientos -->
  <div class="mt-5 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Movimientos</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Fecha</th>
            <th class="px-5 py-2 text-left font-medium">Tipo</th>
            <th class="px-5 py-2 text-left font-medium">Descripción</th>
            <th class="px-5 py-2 text-right font-medium">Monto</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% combined_entries = (@orders.map { |o| {date: o.order_date.to_date, type: 'Ingreso', description: "Orden ##{o.id}", amount: o.total_amount} } +
                                 @expenses.map { |e| {date: e.expense_date, type: 'Gasto', description: e.description, amount: e.amount} })
                                .sort_by { |e| e[:date] }.reverse %>
          <% if combined_entries.any? %>
            <% combined_entries.each do |entry| %>
              <tr class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
                <td class="px-5 py-3 whitespace-nowrap text-gray-500"><%= l(entry[:date]) %></td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= entry[:type] == 'Ingreso' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                    <%= entry[:type] %>
                  </span>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-gray-500"><%= entry[:description] %></td>
                <td class="px-5 py-3 whitespace-nowrap text-right font-medium <%= entry[:type] == 'Ingreso' ? 'text-green-600' : 'text-red-600' %>">
                  <%= entry[:type] == 'Ingreso' ? '+' : '-' %><%= number_to_currency(entry[:amount], unit: 'Gs. ', precision: 0, delimiter: '.') %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-5 py-8 text-center text-sm text-gray-500">
                No hay registros para este rango de fechas
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
