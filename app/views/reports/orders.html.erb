<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Reporte de Ventas</h1>
      <p class="mt-1 text-sm text-gray-500">Análisis detallado de ventas y rendimiento</p>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <%= link_to reports_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver
      <% end %>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Total Ventas</p>
      <p class="mt-1 text-sm font-medium text-gray-900">
        <%= number_to_currency(@total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
      </p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Ventas Completadas</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @total_completed %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Ventas Pendientes</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @total_on_hold %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
      <p class="text-sm text-gray-500">Ventas Canceladas</p>
      <p class="mt-1 text-sm font-medium text-gray-900"><%= @total_cancelled %></p>
    </div>
  </div>

  <div class="mt-6 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100">
      <p class="text-sm font-semibold text-gray-700">Listado de Órdenes</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-5 py-2 text-left font-medium">Fecha</th>
            <th class="px-5 py-2 text-left font-medium">Cliente</th>
            <th class="px-5 py-2 text-left font-medium">Vendedor</th>
            <th class="px-5 py-2 text-left font-medium">Tipo</th>
            <th class="px-5 py-2 text-left font-medium">Método de Pago</th>
            <th class="px-5 py-2 text-left font-medium">Total</th>
            <th class="px-5 py-2 text-left font-medium">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @orders.each do |order| %>
            <tr class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
              <td class="px-5 py-3 whitespace-nowrap"><%= l(order.order_date, format: :short) %></td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                <%= order.customer&.full_name || 'Cliente Final' %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                <%= order.user&.name || 'N/A' %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= order.order_type == 'delivery' ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700' %>">
                  <%= order.order_type.humanize %>
                </span>
              </td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-500">
                <%= order&.payment_method&.name %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap font-medium text-gray-900">
                <%= number_to_currency(order.total_amount, unit: 'Gs. ', precision: 0, delimiter: '.') %>
              </td>
              <td class="px-5 py-3 whitespace-nowrap">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full
                  <%= case order.status
                      when 'completed' then 'bg-green-100 text-green-700'
                      when 'on_hold'   then 'bg-yellow-100 text-yellow-700'
                      when 'cancelled' then 'bg-red-100 text-red-700'
                      end %>">
                  <%= order.status.humanize %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="mt-4 justify-center border-t flex">
  <%= will_paginate @orders, renderer: TailwindPaginateRenderer %>
</div>
