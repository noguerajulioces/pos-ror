<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Categorías</h1>
      <p class="mt-1 text-sm text-gray-500">Mueve los productos de cada subcategoría antes de eliminarla.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_category_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-500" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nueva categoría
      <% end %>
    </div>
  </div>

  <%# ── Tabla ── %>
  <div class="mt-6 bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-xs text-gray-500 uppercase tracking-wide border-b border-gray-100 bg-gray-50">
          <th class="px-5 py-3 text-left font-medium">Nombre</th>
          <th class="px-5 py-3 text-left font-medium hidden sm:table-cell">Productos</th>
          <th class="px-5 py-3 text-right font-medium">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @categories.empty? %>
          <tr>
            <td colspan="3" class="py-16 text-center">
              <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
              </svg>
              <p class="mt-3 text-sm font-medium text-gray-900">Sin categorías</p>
              <p class="mt-1 text-sm text-gray-500">Crea la primera categoría para organizar tus productos.</p>
            </td>
          </tr>
        <% else %>
          <% @categories.each do |category| %>
            <%
              subcats = category.subcategories
              subcats_with_products    = subcats.select { |s| s.products.size > 0 }
              subcats_without_products = subcats.select { |s| s.products.size == 0 }
            %>

            <%# ── Fila de categoría padre ── %>
            <tr class="border-t border-gray-100 hover:bg-gray-50 transition-colors duration-100">
              <td class="px-5 py-3">
                <div class="flex items-center gap-2">
                  <div class="h-7 w-7 flex-shrink-0 rounded-md bg-indigo-50 flex items-center justify-center">
                    <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
                    </svg>
                  </div>
                  <span class="font-semibold text-gray-900"><%= category.name %></span>
                  <% if subcats.any? %>
                    <span class="text-xs text-gray-400"><%= subcats.size %> <%= subcats.size == 1 ? 'subcategoría' : 'subcategorías' %></span>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-3 hidden sm:table-cell">
                <%= render "categories/product_count_badge", category: category, show_zero_label: true %>
              </td>
              <td class="px-5 py-3 text-right">
                <div class="flex items-center justify-end gap-1.5 flex-wrap">
                  <% if category.products.any? %>
                    <%= link_to products_category_path(category),
                        title: "Ver productos",
                        data: { turbo_frame: "modal" },
                        class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      </svg>
                    <% end %>
                  <% end %>
                  <%= link_to new_category_subcategory_path(category),
                      data: { turbo_frame: "modal" },
                      title: "Agregar subcategoría",
                      class: "inline-flex items-center rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm ring-1 ring-inset ring-indigo-200 hover:bg-indigo-100" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                  <% end %>
                  <%= link_to edit_category_path(category),
                      title: "Editar",
                      data: { turbo_frame: "modal" },
                      class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                  <%= button_to category_path(category),
                      method: :delete,
                      form: { data: { turbo_confirm: "¿Eliminar esta categoría y sus subcategorías?" } },
                      title: "Eliminar",
                      class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50 border-0 cursor-pointer" do %>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>

            <%# ── Filas de subcategorías ── %>
            <% subcats.each do |subcategory| %>
              <%= render partial: "subcategories/subcategory", locals: { subcategory: subcategory } %>
            <% end %>

          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Paginación ── %>
  <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
    <%= will_paginate @categories, renderer: TailwindPaginateRenderer %>
  </div>

</div>

<turbo-frame id="modal"></turbo-frame>
