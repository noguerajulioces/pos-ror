<tr id="category_product_<%= product.id %>" class="text-gray-700 hover:bg-gray-50 transition-colors duration-100">
  <td class="px-5 py-3">
    <div class="flex items-center gap-2">
      <span class="text-sm font-medium text-gray-900"><%= product.name %></span>
      <span class="text-xs font-mono bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded"><%= product.sku %></span>
    </div>
  </td>
  <td class="px-5 py-3">
    <%= form_with url: update_category_product_path(product), method: :patch,
        class: "flex items-center gap-2" do |f| %>
      <%= f.select :category_id,
          options_for_select(categories_for_select, product.category_id),
          {},
          class: "block w-full rounded-md border border-gray-300 bg-white py-1.5 pl-3 pr-8 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      <%= f.submit "Mover",
          class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 cursor-pointer whitespace-nowrap" %>
    <% end %>
  </td>
</tr>
