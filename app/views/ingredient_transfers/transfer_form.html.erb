<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6">

        <div class="mb-4">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
            </svg>
            <h3 class="text-lg font-semibold leading-6 text-gray-900" id="modal-title">
              Transferir ingrediente
            </h3>
          </div>
          <p class="mt-1 text-sm text-gray-500">
            <%= @ingredient.name %> &mdash; Stock actual: <strong><%= @ingredient.stock %> <%= @ingredient.unit&.abbreviation %></strong>
          </p>
        </div>

        <% if defined?(@errors) && @errors.any? %>
          <div class="mb-4 rounded-md bg-red-50 p-4">
            <div class="flex">
              <svg class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
              </svg>
              <ul class="ml-3 text-sm font-medium text-red-800 list-disc list-inside">
                <% @errors.each do |error| %>
                  <li><%= error %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <%= form_with url: ingredient_ingredient_transfers_path(@ingredient),
                      method: :post,
                      data: {
                        turbo_frame: "_top",
                        controller: "transfer-form",
                        products_url: ingredients_by_account_ingredient_ingredient_transfers_path(@ingredient, account_id: "ACCOUNT_ID", format: :json)
                      } do |form| %>

          <div class="mb-5">
            <%= form.label :to_account_id, "Sucursal destino", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.collection_select :to_account_id,
                @accounts, :id, :name,
                { include_blank: "Seleccionar sucursal..." },
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-purple-500 sm:text-sm",
                data: {
                  transfer_form_target: "accountSelect",
                  action: "change->transfer-form#accountChanged"
                } %>
          </div>

          <div class="mb-5 hidden" data-transfer-form-target="productWrapper">
            <%= form.label :to_ingredient_id, "Ingrediente en sucursal destino", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <select name="to_ingredient_id"
                    data-transfer-form-target="productSelect"
                    required
                    class="block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-purple-500 sm:text-sm">
              <option value="">Seleccionar ingrediente destino...</option>
            </select>
          </div>

          <div class="mb-5">
            <%= form.label :quantity, "Cantidad a transferir", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.number_field :quantity,
                step: "0.001",
                min: "0.001",
                max: @ingredient.stock,
                required: true,
                placeholder: "Ej: 10",
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-purple-500 sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">
              Máximo disponible: <strong><%= @ingredient.stock %> <%= @ingredient.unit&.abbreviation %></strong>
            </p>
          </div>

          <div class="mb-6">
            <%= form.label :reason, "Razón de la transferencia", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :reason,
                rows: 2,
                required: true,
                placeholder: "Ej: Reposición por quiebre de stock",
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-purple-500 sm:text-sm" %>
          </div>

          <div class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3">
            <%= form.submit "Transferir",
                class: "inline-flex w-full justify-center rounded-md bg-purple-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 sm:col-start-2 cursor-pointer" %>
            <button type="button"
                onclick="document.querySelector('turbo-frame#modal').innerHTML = ''"
                class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:col-start-1 sm:mt-0">
              Cancelar
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
