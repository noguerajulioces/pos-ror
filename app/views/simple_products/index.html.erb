<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900">Productos Simples</h1>
      <p class="mt-2 text-sm text-gray-700">Lista de productos simples disponibles en el inventario.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <div class="flex space-x-3">
        <%= link_to hub_products_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 inline-flex items-center" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al Hub
        <% end %>
        <%= link_to new_simple_product_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 inline-flex items-center" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Nuevo Producto Simple
        <% end %>
      </div>
    </div>
  </div>

  <%= search_form_for @q, class: "mt-8 mb-4" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="px-4 py-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-4">
          <div>
            <%= f.label :name_or_sku_cont, "Nombre, SKU", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.search_field :name_or_sku_cont, 
                placeholder: "Buscar por nombre",
                class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
          </div>

          <div>
            <%= f.label :category_id_eq, "Categoría", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.collection_select :category_id_eq,
                Category.where.not(parent_id: nil),
                :id,
                :name,
                { include_blank: "Todas las categorías" },
                class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
          </div>

          <div>
            <%= f.label :stock_lteq, "Stock mínimo", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.number_field :stock_lteq,
                placeholder: "Stock menor o igual a",
                class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-x-3 border-t border-gray-900/10 px-4 py-4 sm:px-8">
        <%= f.submit "Buscar", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        <%= link_to "Limpiar", simple_products_path, class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">#</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Imagen</th>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">SKU</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Nombre</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Categoría</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Precio</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Stock</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Estado</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @products.each.with_index(1) do |product, index| %>
                <tr id="product_<%= product.id %>">
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                    <%= index %>
                  </td>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                    <% if product.images.any? && product.images.first.image.attached? %>
                      <%= image_tag product.images.first.image.variant(resize_to_fill: [100, 100]), alt: product.name, class: 'shadow-md rounded-md' %>
                    <% else %>
                      <span>-</span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                    <%= product.sku %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= product.name %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= product.category&.name %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <strong>
                      <%= number_to_currency(product.price.to_i, unit: "₲s. ", precision: 0, delimiter: '.') %>
                    </strong>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= product.stock %> <%= product&.unit&.abbreviation %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm">
                    <% case product.status %>
                    <% when 'active' %>
                      <span class="inline-flex rounded-full px-2 text-xs font-semibold leading-5 text-green-600 bg-green-100">
                        Activo
                      </span>
                    <% when 'inactive' %>
                      <span class="inline-flex rounded-full px-2 text-xs font-semibold leading-5 text-red-600 bg-red-100">
                        Inactivo
                      </span>
                    <% when 'out_of_stock' %>
                      <span class="inline-flex rounded-full px-2 text-xs font-semibold leading-5 text-yellow-600 bg-yellow-100">
                        Sin Stock
                      </span>
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <%= link_to "Ver", simple_product_path(product), class: "text-indigo-600 hover:text-indigo-900" %>
                    <%= link_to "Editar", edit_simple_product_path(product), class: "ml-2 text-indigo-600 hover:text-indigo-900" %>
                    
                    <% case product.status %>
                    <% when 'active' %>
                      <%= link_to "Inactivar", update_status_simple_product_path(product), 
                          data: { turbo_method: :patch, turbo_confirm: "¿Inactivar este producto?" }, 
                          class: "ml-2 text-red-600 hover:text-red-900" %>
                    <% when 'inactive' %>
                      <%= link_to "Activar", update_status_simple_product_path(product), 
                          data: { turbo_method: :patch, turbo_confirm: "¿Activar este producto?" }, 
                          class: "ml-2 text-green-600 hover:text-green-900" %>
                    <% when 'out_of_stock' %>
                      <% if product.stock > 0 %>
                        <%= link_to "Activar", update_status_simple_product_path(product), 
                            data: { turbo_method: :patch, turbo_confirm: "¿Activar este producto?" }, 
                            class: "ml-2 text-green-600 hover:text-green-900" %>
                      <% else %>
                        <span class="ml-2 text-gray-400 text-sm">Sin stock</span>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-4 justify-center border-t flex">
  <%= will_paginate @products, renderer: TailwindPaginateRenderer %>
</div>
