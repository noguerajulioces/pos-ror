<div class="w-full">
  <div class="mb-4">
    <h3 class="text-lg font-medium text-gray-900" id="modal-title">
      Agregar Ingrediente a la Receta
    </h3>
    <p class="mt-1 text-sm text-gray-500">
      Busca un ingrediente existente o crea uno nuevo
    </p>
  </div>

  <% if error.present? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-md">
      <p class="text-sm text-red-600"><%= error %></p>
    </div>
  <% end %>

  <!-- Search Form -->
  <div class="mb-4" data-controller="ingredient-picker" data-ingredient-picker-product-id-value="<%= product.id %>">
    <label for="search_query" class="block text-sm font-medium text-gray-700 mb-2">
      Buscar ingrediente
    </label>
    <div class="relative">
      <input type="text" 
             id="search_query" 
             name="q" 
             placeholder="Escribe el nombre del ingrediente..."
             class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
             data-ingredient-picker-target="input"
             data-action="input->ingredient-picker#search">
      <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div class="hidden mb-4" data-ingredient-picker-target="loading">
    <div class="flex items-center justify-center py-4">
      <svg class="animate-spin h-5 w-5 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-2 text-sm text-gray-600">Buscando...</span>
    </div>
  </div>

  <!-- Search Results -->
  <div id="search_results" data-ingredient-picker-target="results">
    <div class="text-center py-8 text-gray-500">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <p class="mt-2 text-sm">Escribe para buscar ingredientes</p>
    </div>
  </div>

  <!-- Create Form (hidden by default) -->
  <div class="hidden" data-ingredient-picker-target="createForm">
    <%= render "ingredients/form_inline", ingredient: Ingredient.new, product: product %>
  </div>
</div>
