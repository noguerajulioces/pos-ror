<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" 
       data-controller="modal ingredient-picker" 
       data-product-id="<%= @product.id %>"
       data-action="click->modal#close keydown@window->modal#closeWithKeyboard">
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
  
  <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl sm:p-6">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 flex items-center">
            <svg class="h-5 w-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Agregar Ingredientes a la Receta
          </h3>
          <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="mb-6">
          <div class="relative">
            <input type="text" 
                   id="ingredient-search" 
                   placeholder="Buscar ingredientes..." 
                   data-action="input->ingredient-picker#search"
                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Ingredients Grid -->
        <div id="ingredients-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-h-96 overflow-y-auto mb-6">
          <% Ingredient.includes(:unit).ordered.each do |ingredient| %>
            <div class="ingredient-card border border-gray-200 rounded-lg p-4 hover:border-indigo-300 hover:shadow-md transition-all duration-200 cursor-pointer"
                 data-ingredient-id="<%= ingredient.id %>"
                 data-ingredient-name="<%= ingredient.name %>"
                 data-ingredient-unit="<%= ingredient.unit.name %>"
                 data-ingredient-stock="<%= ingredient.stock %>"
                 data-action="click->ingredient-picker#selectIngredient">
              
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h4 class="text-sm font-medium text-gray-900"><%= ingredient.name %></h4>
                  <p class="text-xs text-gray-500 mt-1">
                    SKU: <%= ingredient.sku.present? ? ingredient.sku : 'N/A' %>
                  </p>
                </div>
                
                <!-- Stock Status -->
                <div class="ml-2">
                  <% case ingredient.stock_status %>
                  <% when 'out_of_stock' %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Sin Stock
                    </span>
                  <% when 'low_stock' %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      Stock Bajo
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Disponible
                    </span>
                  <% end %>
                </div>
              </div>
              
              <div class="mt-3 flex items-center justify-between">
                <div class="text-sm text-gray-600">
                  <span class="font-medium"><%= ingredient.stock %></span> <%= ingredient.unit.abbreviation %>
                </div>
                <div class="text-xs text-gray-500">
                  ₲s. <%= number_with_delimiter(ingredient.average_cost, delimiter: '.') %>
                </div>
              </div>

              <!-- Selection indicator -->
              <div class="selected-indicator hidden mt-2">
                <div class="w-full h-2 bg-indigo-100 rounded-full">
                  <div class="h-2 bg-indigo-600 rounded-full w-full"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Selected Ingredients Form -->
        <div id="selected-ingredients" class="hidden">
          <div class="border-t border-gray-200 pt-6">
            <h4 class="text-lg font-medium text-gray-900 mb-4">Ingredientes Seleccionados</h4>
            
            <%= form_with url: product_products_recipe_components_path(@product), 
                         method: :post, 
                         data: { turbo: true, controller: "recipe-form" },
                         class: "space-y-4" do |form| %>
              
              <div id="selected-ingredients-container" class="space-y-4">
                <!-- Los ingredientes seleccionados se agregan aquí dinámicamente -->
              </div>

              <!-- Action buttons -->
              <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
                <button type="button" 
                        data-action="click->modal#close"
                        class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                  Cancelar
                </button>
                <button type="submit" 
                        class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                  Agregar Ingredientes
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-4">
          <div class="text-sm text-gray-500">
            Selecciona los ingredientes para tu receta
          </div>
          <div class="flex items-center space-x-2">
            <%= link_to "Crear Nuevo Ingrediente", 
                        new_ingredient_path(product_id: @product.id), 
                        data: { turbo_frame: "modal" },
                        class: "text-sm text-indigo-600 hover:text-indigo-800" %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>