<% if ingredients.any? %>
  <div class="space-y-2">
    <h4 class="text-sm font-medium text-gray-700 mb-3">
      Resultados para "<%= query %>"
    </h4>
    
    <% ingredients.each do |ingredient| %>
      <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200 hover:bg-gray-100 transition-colors">
        <div class="flex-1">
          <h5 class="text-sm font-medium text-gray-900"><%= ingredient.name %></h5>
          <p class="text-xs text-gray-500">
            <%= ingredient.unit&.name %> • Stock: <%= ingredient.stock || 0 %>
          </p>
        </div>
        <button type="button" 
                class="ml-3 inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                data-action="click->ingredient-picker#selectIngredient"
                data-ingredient-id="<%= ingredient.id %>"
                data-ingredient-name="<%= ingredient.name %>"
                data-ingredient-unit-id="<%= ingredient.unit_id %>">
          Elegir
        </button>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-6">
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <h4 class="mt-2 text-sm font-medium text-gray-900">No se encontraron ingredientes</h4>
    <p class="mt-1 text-sm text-gray-500">
      No hay ingredientes que coincidan con "<%= query %>"
    </p>
    <div class="mt-4">
      <button type="button" 
              class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
              data-action="click->ingredient-picker#showCreateForm"
              data-ingredient-name="<%= query %>">
        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Crear "<%= query %>" como nuevo ingrediente
      </button>
    </div>
  </div>
<% end %>
