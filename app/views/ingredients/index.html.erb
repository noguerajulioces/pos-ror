<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold leading-6 text-gray-900">Ingredientes</h1>
      <p class="mt-2 text-sm text-gray-700">Lista de ingredientes disponibles para recetas y preparaciones.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to "Nuevo Ingrediente", new_ingredient_path, class: "block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  </div>

  <!-- Búsqueda -->
  <div class="mt-6">
    <%= search_form_for @q, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :name_cont, "Nombre", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name_cont, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Buscar por nombre..." %>
        </div>
        <div>
          <%= f.label :sku_cont, "SKU", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :sku_cont, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Buscar por SKU..." %>
        </div>
        <div class="flex items-end">
          <%= f.submit "Buscar", class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Nombre</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">SKU</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Unidad</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Stock</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Stock Mín.</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Costo Prom.</th>
              <th scope="col" class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900">Estado</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
                <span class="sr-only">Acciones</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @ingredients.each do |ingredient| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0">
                  <%= link_to ingredient.name, ingredient_path(ingredient), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= ingredient.sku %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= ingredient.unit.name %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-gray-500"><%= number_with_delimiter(ingredient.stock, delimiter: '.') %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-gray-500"><%= number_with_delimiter(ingredient.min_stock, delimiter: '.') %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-gray-500"><%= number_to_currency(ingredient.average_cost, delimiter: '.', precision: 0, unit: '₲s. ') %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= case ingredient.stock_status
                        when 'in_stock' then 'bg-green-100 text-green-800'
                        when 'low_stock' then 'bg-yellow-100 text-yellow-800'
                        when 'out_of_stock' then 'bg-red-100 text-red-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= case ingredient.stock_status
                        when 'in_stock' then 'En Stock'
                        when 'low_stock' then 'Stock Bajo'
                        when 'out_of_stock' then 'Sin Stock'
                        else 'Desconocido'
                        end %>
                  </span>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-0">
                  <%= link_to "Editar", edit_ingredient_path(ingredient), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Paginación -->
  <div class="mt-6">
    <%= will_paginate @ingredients, renderer: TailwindPaginateRenderer %>
  </div>
</div>
