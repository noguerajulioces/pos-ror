<div class="px-4 sm:px-6 lg:px-8">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Ingredientes</h1>
      <p class="mt-1 text-sm text-gray-500">Inventario de ingredientes para recetas y preparaciones.</p>
    </div>
    <div class="mt-4 sm:mt-0 inline-flex gap-x-3">
      <% if current_user.has_role?(:superadmin) %>
        <%= link_to hub_products_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 inline-flex items-center gap-x-1.5" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Hub
        <% end %>
        <%= link_to new_ingredient_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 inline-flex items-center gap-x-1.5" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nuevo ingrediente
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Stats cards ────────────────────────────────────────────────────── %>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Total ingredientes</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_count %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-amber-600">Stock bajo</dt>
      <dd class="mt-1 flex items-baseline gap-x-2">
        <span class="text-3xl font-semibold tracking-tight text-amber-600"><%= @low_stock_count %></span>
        <% if @low_stock_count > 0 %>
          <%= link_to "Ver", ingredients_path(q: { stock_lteq: 1 }), class: "text-xs text-amber-600 underline hover:text-amber-800" %>
        <% end %>
      </dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5 px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-red-600">Sin stock</dt>
      <dd class="mt-1 flex items-baseline gap-x-2">
        <span class="text-3xl font-semibold tracking-tight text-red-600"><%= @out_of_stock_count %></span>
        <% if @out_of_stock_count > 0 %>
          <%= link_to "Ver", ingredients_path(q: { stock_lteq: 0 }), class: "text-xs text-red-600 underline hover:text-red-800" %>
        <% end %>
      </dd>
    </div>
  </div>

  <%# ── Search form ─────────────────────────────────────────────────────── %>
  <%= search_form_for @q, url: ingredients_path, class: "mt-6" do |f| %>
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-4">
          <div>
            <%= f.label :name_or_sku_cont, "Nombre / SKU", class: "block text-sm font-medium text-gray-900" %>
            <%= f.search_field :name_or_sku_cont,
                placeholder: "Buscar por nombre o SKU…",
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :unit_id_eq, "Unidad", class: "block text-sm font-medium text-gray-900" %>
            <%= f.collection_select :unit_id_eq,
                Unit.all, :id, :name,
                { include_blank: "Todas las unidades" },
                class: "mt-1 block w-full rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
          <div>
            <%= f.label :stock_lteq, "Stock ≤", class: "block text-sm font-medium text-gray-900" %>
            <%= f.number_field :stock_lteq,
                placeholder: "ej. 5",
                class: "mt-1 block w-full rounded-md bg-white px-3 py-1.5 text-sm text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600" %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-x-3 border-t border-gray-900/10 px-4 py-3 sm:px-6">
        <%= f.submit "Buscar",
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <%= link_to "Limpiar", ingredients_path,
            class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="mt-6 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black/5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Ingrediente</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">SKU</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Unidad</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Stock actual</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Mínimo</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Costo prom.</th>
                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Estado</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% if @ingredients.empty? %>
                <tr>
                  <td colspan="8" class="py-16 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 1-6.23-.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                    </svg>
                    <p class="mt-3 text-sm font-medium text-gray-900">Sin resultados</p>
                    <p class="mt-1 text-sm text-gray-500">No se encontraron ingredientes con los filtros aplicados.</p>
                    <%= link_to "Limpiar filtros", ingredients_path, class: "mt-4 inline-block text-sm text-indigo-600 hover:text-indigo-500 underline" %>
                  </td>
                </tr>
              <% else %>
                <% @ingredients.each do |ingredient| %>
                  <tr class="<%= ingredient_row_class(ingredient) %> hover:bg-gray-50 transition-colors duration-100">

                    <%# Ingrediente: nombre %>
                    <td class="py-3 pl-4 pr-3 sm:pl-6">
                      <p class="text-sm font-medium text-gray-900"><%= ingredient.name %></p>
                    </td>

                    <%# SKU %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500 font-mono">
                      <%= ingredient.sku.presence || '—' %>
                    </td>

                    <%# Unidad %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">
                      <%= ingredient.unit.name %>
                    </td>

                    <%# Stock actual %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm">
                      <span class="font-semibold text-gray-900">
                        <%= number_with_delimiter(ingredient.stock, delimiter: '.') %>
                      </span>
                      <span class="text-xs text-gray-400 ml-0.5"><%= ingredient.unit.abbreviation %></span>
                    </td>

                    <%# Mínimo %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">
                      <% if ingredient.min_stock.to_d > 0 %>
                        <%= number_with_delimiter(ingredient.min_stock, delimiter: '.') %>
                        <span class="text-xs text-gray-400"><%= ingredient.unit.abbreviation %></span>
                      <% else %>
                        <span class="text-gray-300">—</span>
                      <% end %>
                    </td>

                    <%# Costo promedio %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm font-medium text-gray-900">
                      <%= number_to_currency(ingredient.average_cost.to_i, unit: "₲", precision: 0, delimiter: '.') %>
                    </td>

                    <%# Estado badge %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm">
                      <%= ingredient_stock_badge(ingredient) %>
                    </td>

                    <%# Acciones %>
                    <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right sm:pr-6">
                      <div class="flex items-center justify-end gap-x-2">
                        <%= link_to adjust_stock_form_ingredient_path(ingredient),
                            data: { turbo_frame: "modal" },
                            title: "Ajustar stock",
                            class: "inline-flex items-center gap-x-1 rounded-md bg-green-50 px-2.5 py-1.5 text-xs font-semibold text-green-700 shadow-sm ring-1 ring-inset ring-green-200 hover:bg-green-100" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                          </svg>
                          Ajustar
                        <% end %>

                        <%= link_to transfer_form_ingredient_ingredient_transfers_path(ingredient),
                            data: { turbo_frame: "modal" },
                            title: "Transferir a otra sucursal",
                            class: "inline-flex items-center gap-x-1 rounded-md bg-purple-50 px-2.5 py-1.5 text-xs font-semibold text-purple-700 shadow-sm ring-1 ring-inset ring-purple-200 hover:bg-purple-100" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                          </svg>
                          Transferir
                        <% end %>

                        <%= link_to ingredient_path(ingredient),
                            title: "Ver ingrediente",
                            class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                          </svg>
                        <% end %>

                        <% if current_user.has_role?(:superadmin) %>
                          <%= link_to edit_ingredient_path(ingredient),
                              title: "Editar ingrediente",
                              class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          <% end %>
                        <% end %>
                      </div>
                    </td>

                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────── %>
  <div class="mt-4 flex justify-center border-t border-gray-100 pt-4">
    <%= will_paginate @ingredients, renderer: TailwindPaginateRenderer %>
  </div>

</div>
