<%= form_with(model: @ingredient, class: "space-y-8") do |form| %>
  <% if @ingredient.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Se encontraron <%= @ingredient.errors.count %> errores:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @ingredient.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Información básica -->
  <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
    <div class="px-4 py-6 sm:p-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-6">Información Básica</h3>
      
      <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:grid-cols-2">
        <div class="col-span-1">
          <%= form.label :name, "Nombre", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2">
            <%= form.text_field :name, 
                id: "ingredient_name",
                class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
            <div id="name-validation-message" class="mt-1 text-sm hidden"></div>
          </div>
        </div>

        <div class="col-span-1">
          <%= form.label :sku, "SKU", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2">
            <div class="flex gap-2">
              <%= form.text_field :sku, class: "flex-1 border rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
              <button type="button" 
                      id="generate-sku-btn" 
                      class="rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-500 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Autogenerar
              </button>
            </div>
          </div>
        </div>

        <div class="col-span-1">
          <%= form.label :unit_id, "Unidad de Medida", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2 relative">
            <%= form.collection_select :unit_id, Unit.all, :id, :name, { prompt: "Selecciona una unidad" },
                { class: "block w-full rounded-md bg-white px-3 pr-10 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 appearance-none" } %>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
              <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stock y costos -->
  <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
    <div class="px-4 py-6 sm:p-8">
      <h3 class="text-lg font-semibold text-gray-900 mb-6">Stock y Costos</h3>
      
      <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 md:grid-cols-2" data-controller="initial-cost">
        <div class="col-span-1">
          <%= form.label :stock, @ingredient.new_record? ? "Stock Inicial" : "Stock", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2">
            <%= form.number_field :stock, 
                step: "0.001", 
                min: "0", 
                disabled: @ingredient.persisted?,
                data: {
                  action: "input->initial-cost#toggleCostField",
                  initial_cost_target: "stockField"
                },
                class: "#{@ingredient.persisted? ? 'disabled:opacity-50 disabled:bg-gray-100' : ''} block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 text-right" %>
            <% if @ingredient.persisted? %>
              <p class="mt-1 text-sm text-gray-500">El stock se modifica a través de compras y movimientos de inventario</p>
            <% end %>

            <!-- Costo Inicial (solo para ingredientes nuevos con stock) -->
            <% if @ingredient.new_record? %>
              <div class="mt-4" data-initial-cost-target="costField" style="display: none;" data-controller="number-format">
                <%= form.label :average_cost, "Costo Inicial por Unidad", class: "block text-sm/6 font-medium text-gray-900" %>
                <div class="mt-2">
                  <div class="flex">
                    <span class="inline-flex items-center px-3 py-2 border border-r-0 border-gray-300 bg-gray-50 text-gray-500 text-sm rounded-l-md">
                      ₲s.
                    </span>
                    <%= form.text_field :average_cost, 
                        data: { number_format_target: "input" },
                        value: (form.object.average_cost.present? ? form.object.average_cost.to_i : nil),
                        class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 rounded-l-none text-right",
                        placeholder: "0" %>
                  </div>
                </div>
                <p class="mt-1 text-sm text-gray-500">Costo por unidad del stock inicial</p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="col-span-1">
          <%= form.label :min_stock, "Stock Mínimo", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2">
            <%= form.number_field :min_stock, step: "0.001", min: "0", class: "block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 text-right" %>
          </div>
        </div>

        <div class="col-span-1">
          <%= form.label :average_cost, "Costo Promedio", class: "block text-sm/6 font-medium text-gray-900" %>
          <div class="mt-2">
            <%= form.text_field :average_cost,
                value: @ingredient.average_cost.present? ? number_with_delimiter(@ingredient.average_cost.to_i, delimiter: '.') : nil,
                data: {
                      controller: "number-format",
                      "number-format-target": "input",
                      action: "input->number-format#formatNumber"
                    },
                class: "disabled:opacity-50 block w-full rounded-md bg-white px-3 py-2 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 text-right",
                disabled: true %>
            <p class="mt-1 text-sm text-gray-500">Se calcula automáticamente al comprar</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Botones de acción -->
  <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
    <%= link_to "Cancelar", ingredients_path, class: "text-sm/6 font-semibold text-gray-900" %>
    <%= form.submit "Guardar", 
        id: "submit-btn",
        class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const generateSkuBtn = document.getElementById('generate-sku-btn');
  const nameField = document.getElementById('ingredient_name');
  const skuField = document.getElementById('ingredient_sku');
  const submitBtn = document.getElementById('submit-btn');
  const validationMessage = document.getElementById('name-validation-message');
  const currentIngredientId = <%= @ingredient.id || 'null' %>;
  
  let validationTimeout;
  let isNameValid = true;
  
  // Validación del nombre en tiempo real
  if (nameField) {
    nameField.addEventListener('input', function() {
      clearTimeout(validationTimeout);
      const name = this.value.trim();
      
      if (!name) {
        resetValidation();
        return;
      }
      
      // Debounce la validación
      validationTimeout = setTimeout(() => {
        validateNameUniqueness(name);
      }, 500);
    });
  }
  
  function validateNameUniqueness(name) {
    fetch('/ingredients/check_name_uniqueness', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ 
        name: name,
        current_id: currentIngredientId
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.exists) {
        showValidationError('Ya existe un ingrediente con este nombre');
        isNameValid = false;
      } else {
        showValidationSuccess('Nombre disponible');
        isNameValid = true;
      }
      updateSubmitButton();
    })
    .catch(error => {
      console.error('Error validating name:', error);
      resetValidation();
    });
  }
  
  function showValidationError(message) {
    nameField.classList.remove('outline-gray-300', 'focus:outline-indigo-600', 'ring-2', 'ring-green-500');
    nameField.classList.add('outline-red-500', 'focus:outline-red-500', 'ring-2', 'ring-red-500');
    
    validationMessage.textContent = message;
    validationMessage.className = 'mt-1 text-sm text-red-600';
    validationMessage.classList.remove('hidden');
  }
  
  function showValidationSuccess(message) {
    nameField.classList.remove('outline-red-500', 'focus:outline-red-500', 'ring-2', 'ring-red-500');
    nameField.classList.add('outline-gray-300', 'focus:outline-indigo-600', 'ring-2', 'ring-green-500');
    
    validationMessage.textContent = message;
    validationMessage.className = 'mt-1 text-sm text-green-600';
    validationMessage.classList.remove('hidden');
    
    // Remover el borde verde después de 2 segundos
    setTimeout(() => {
      nameField.classList.remove('ring-2', 'ring-green-500');
    }, 2000);
  }
  
  function resetValidation() {
    nameField.classList.remove('outline-red-500', 'focus:outline-red-500', 'ring-2', 'ring-red-500', 'ring-green-500');
    nameField.classList.add('outline-gray-300', 'focus:outline-indigo-600');
    
    validationMessage.classList.add('hidden');
    isNameValid = true;
    updateSubmitButton();
  }
  
  function updateSubmitButton() {
    if (submitBtn) {
      submitBtn.disabled = !isNameValid;
    }
  }
  
  // Funcionalidad del botón de generar SKU
  if (generateSkuBtn && nameField && skuField) {
    generateSkuBtn.addEventListener('click', function() {
      const name = nameField.value.trim();
      
      if (!name) {
        alert('Por favor, ingresa un nombre para el ingrediente primero.');
        nameField.focus();
        return;
      }
      
      if (!isNameValid) {
        alert('No se puede generar SKU porque el nombre ya existe. Por favor, elige un nombre diferente.');
        return;
      }
      
      // Generar SKU basado en el nombre
      const sku = generateSKU(name);
      skuField.value = sku;
      
      // Mostrar feedback visual
      skuField.classList.add('ring-2', 'ring-green-500');
      setTimeout(() => {
        skuField.classList.remove('ring-2', 'ring-green-500');
      }, 1000);
    });
  }
  
  function generateSKU(name) {
    // Convertir a mayúsculas y remover caracteres especiales
    let cleanName = name.toUpperCase()
                       .replace(/[ÁÀÄÂ]/g, 'A')
                       .replace(/[ÉÈËÊ]/g, 'E')
                       .replace(/[ÍÌÏÎ]/g, 'I')
                       .replace(/[ÓÒÖÔ]/g, 'O')
                       .replace(/[ÚÙÜÛ]/g, 'U')
                       .replace(/Ñ/g, 'N')
                       .replace(/[^A-Z0-9\s]/g, '')
                       .replace(/\s+/g, ' ')
                       .trim();
    
    // Tomar las primeras letras de cada palabra (máximo 3 palabras)
    const words = cleanName.split(' ').slice(0, 3);
    let acronym = '';
    
    words.forEach(word => {
      if (word.length > 0) {
        // Si la palabra tiene más de 3 caracteres, tomar los primeros 2
        // Si tiene 3 o menos, tomar toda la palabra
        acronym += word.length > 3 ? word.substring(0, 2) : word;
      }
    });
    
    // Limitar a 6 caracteres y agregar prefijo ING
    acronym = acronym.substring(0, 6);
    
    // Generar número aleatorio de 2 dígitos
    const randomNum = Math.floor(Math.random() * 100).toString().padStart(2, '0');
    
    return `ING-${acronym}-${randomNum}`;
  }
});
</script>
