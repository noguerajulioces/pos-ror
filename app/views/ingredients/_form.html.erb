<%= form_with(model: @ingredient, local: true) do |form| %>

  <%# ── Errores ─────────────────────────────────────────────── %>
  <% if @ingredient.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4">
      <div class="flex gap-3">
        <svg class="h-5 w-5 text-red-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <div>
          <p class="text-sm font-medium text-red-800"><%= @ingredient.errors.count %> error(es) impiden guardar:</p>
          <ul class="mt-1 list-disc pl-4 text-sm text-red-700 space-y-0.5">
            <% @ingredient.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Layout principal (2 columnas) ─────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">

    <%# ── Columna izquierda (2/3) ────────────────────────── %>
    <div class="lg:col-span-2 space-y-6">

      <%# Identificación %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Identificación</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

          <div class="sm:col-span-2">
            <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" do %>
              Nombre <span class="text-red-500">*</span>
            <% end %>
            <%= form.text_field :name,
                id: "ingredient_name",
                placeholder: "Ej: Harina de trigo",
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm" %>
            <div id="name-validation-message" class="mt-1 text-sm hidden"></div>
          </div>

          <div>
            <%= form.label :sku, "SKU", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="flex">
              <%= form.text_field :sku,
                  id: "ingredient_sku",
                  placeholder: "ING-001",
                  class: "block w-full rounded-l-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm" %>
              <button type="button"
                      id="generate-sku-btn"
                      title="Generar SKU automático"
                      class="inline-flex items-center gap-1 px-3 py-2 border border-l-0 border-gray-300 bg-gray-50 text-gray-500 text-xs rounded-r-lg hover:bg-gray-100 whitespace-nowrap">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Auto
              </button>
            </div>
          </div>

          <div>
            <%= form.label :unit_id, "Unidad de medida", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="relative">
              <%= form.collection_select :unit_id, Unit.all, :id, :name,
                  { prompt: "Selecciona unidad" },
                  { class: "block w-full rounded-lg border-0 px-3 pr-8 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-500 sm:text-sm appearance-none" } %>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5">
                <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div><%# /columna izquierda %>

    <%# ── Columna derecha (1/3) ────────────────────────────── %>
    <div class="space-y-6">

      <%# Stock %>
      <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6" data-controller="initial-cost">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Stock</h2>
        <div class="space-y-4">

          <div>
            <%= form.label :stock, @ingredient.new_record? ? "Stock inicial" : "Stock actual",
                class: "block text-sm font-medium text-gray-700 mb-1" %>
            <% if @ingredient.persisted? %>
              <div class="flex items-center gap-2 py-2">
                <span class="text-2xl font-bold text-gray-900"><%= @ingredient.stock.to_f %></span>
                <span class="text-sm text-gray-500"><%= @ingredient.unit&.abbreviation %></span>
              </div>
              <p class="text-xs text-gray-400">Se modifica a través de compras y movimientos</p>
              <%= form.hidden_field :stock %>
            <% else %>
              <%= form.number_field :stock,
                  step: "0.001", min: "0", placeholder: "0",
                  data: {
                    action: "input->initial-cost#toggleCostField",
                    initial_cost_target: "stockField"
                  },
                  class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm text-right" %>
            <% end %>
          </div>

          <div>
            <%= form.label :min_stock, "Stock mínimo", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :min_stock,
                step: "0.001", min: "0", placeholder: "0",
                class: "block w-full rounded-lg border-0 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-500 sm:text-sm text-right" %>
            <p class="mt-1 text-xs text-gray-400">Alerta cuando baje de este valor</p>
          </div>

          <% if @ingredient.new_record? %>
            <div data-initial-cost-target="costField" style="display:none;" data-controller="number-format">
              <%= form.label :average_cost, "Costo inicial por unidad", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative flex rounded-lg ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-indigo-500">
                <span class="inline-flex items-center px-3 text-gray-500 text-sm bg-gray-50 rounded-l-lg border-r border-gray-300">₲s.</span>
                <%= form.text_field :average_cost,
                    data: { number_format_target: "input" },
                    value: (@ingredient.average_cost.present? ? @ingredient.average_cost.to_i : nil),
                    placeholder: "0",
                    class: "block w-full border-0 bg-transparent px-3 py-2.5 text-gray-900 placeholder:text-gray-400 focus:ring-0 sm:text-sm text-right rounded-r-lg" %>
              </div>
            </div>
          <% end %>

        </div>
      </div>

      <%# Costo promedio (solo edición) %>
      <% if @ingredient.persisted? %>
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-200 p-6">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Costo</h2>
          <div>
            <p class="text-xs text-gray-400 mb-2">Costo promedio (calculado automáticamente)</p>
            <div class="flex items-baseline gap-1">
              <span class="text-xs text-gray-500">₲s.</span>
              <span class="text-xl font-bold text-gray-900">
                <%= @ingredient.average_cost.present? ? number_with_delimiter(@ingredient.average_cost.to_i, delimiter: '.') : '—' %>
              </span>
              <span class="text-xs text-gray-400">/ <%= @ingredient.unit&.abbreviation %></span>
            </div>
            <p class="mt-1.5 text-xs text-gray-400">Se actualiza al registrar compras</p>
          </div>
        </div>
      <% end %>

    </div><%# /columna derecha %>
  </div><%# /grid %>

  <%# ── Acciones ────────────────────────────────────────────── %>
  <div class="mt-6 flex items-center justify-end gap-3 pb-8">
    <%= link_to "Cancelar", ingredients_path,
        class: "rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= form.submit @ingredient.persisted? ? "Guardar cambios" : "Crear ingrediente",
        id: "submit-btn",
        class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" %>
  </div>

<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const generateSkuBtn = document.getElementById('generate-sku-btn');
  const nameField = document.getElementById('ingredient_name');
  const skuField = document.getElementById('ingredient_sku');
  const submitBtn = document.getElementById('submit-btn');
  const validationMessage = document.getElementById('name-validation-message');
  const currentIngredientId = <%= @ingredient.id || 'null' %>;

  let validationTimeout;
  let isNameValid = true;

  if (nameField) {
    nameField.addEventListener('input', function() {
      clearTimeout(validationTimeout);
      const name = this.value.trim();
      updateSkuButton();
      if (!name) { resetValidation(); return; }
      validationTimeout = setTimeout(() => validateNameUniqueness(name), 500);
    });
  }

  function updateSkuButton() {
    if (generateSkuBtn && nameField) {
      const disabled = !nameField.value.trim() || !isNameValid;
      generateSkuBtn.disabled = disabled;
      generateSkuBtn.classList.toggle('opacity-50', disabled);
      generateSkuBtn.classList.toggle('cursor-not-allowed', disabled);
    }
  }

  updateSkuButton();

  function validateNameUniqueness(name) {
    fetch('/ingredients/check_name_uniqueness', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ name, current_id: currentIngredientId })
    })
    .then(r => r.json())
    .then(data => {
      if (data.exists) {
        showValidationError('Ya existe un ingrediente con este nombre');
        isNameValid = false;
      } else {
        showValidationSuccess('Nombre disponible');
        isNameValid = true;
      }
      updateSubmitButton();
      updateSkuButton();
    })
    .catch(() => { resetValidation(); updateSkuButton(); });
  }

  function showValidationError(message) {
    nameField.classList.remove('ring-inset', 'ring-gray-300', 'focus:ring-indigo-500');
    nameField.classList.add('ring-red-500', 'focus:ring-red-500');
    validationMessage.textContent = message;
    validationMessage.className = 'mt-1 text-sm text-red-600';
    validationMessage.classList.remove('hidden');
  }

  function showValidationSuccess(message) {
    nameField.classList.remove('ring-red-500', 'focus:ring-red-500');
    nameField.classList.add('ring-green-500');
    validationMessage.textContent = message;
    validationMessage.className = 'mt-1 text-sm text-green-600';
    validationMessage.classList.remove('hidden');
    setTimeout(() => nameField.classList.remove('ring-green-500'), 2000);
  }

  function resetValidation() {
    nameField.classList.remove('ring-red-500', 'focus:ring-red-500', 'ring-green-500');
    validationMessage.classList.add('hidden');
    isNameValid = true;
    updateSubmitButton();
    updateSkuButton();
  }

  function updateSubmitButton() {
    if (submitBtn) submitBtn.disabled = !isNameValid;
  }

  if (generateSkuBtn && nameField && skuField) {
    generateSkuBtn.addEventListener('click', function() {
      const name = nameField.value.trim();
      if (!name || !isNameValid) return;
      skuField.value = generateSKU(name);
      skuField.classList.add('ring-2', 'ring-green-500');
      setTimeout(() => skuField.classList.remove('ring-2', 'ring-green-500'), 1000);
    });
  }

  function generateSKU(name) {
    let clean = name.toUpperCase()
      .replace(/[ÁÀÄÂ]/g,'A').replace(/[ÉÈËÊ]/g,'E')
      .replace(/[ÍÌÏÎ]/g,'I').replace(/[ÓÒÖÔ]/g,'O')
      .replace(/[ÚÙÜÛ]/g,'U').replace(/Ñ/g,'N')
      .replace(/[^A-Z0-9\s]/g,'').replace(/\s+/g,' ').trim();
    const words = clean.split(' ').slice(0, 3);
    let acronym = words.map(w => w.length > 3 ? w.substring(0,2) : w).join('').substring(0, 6);
    const num = Math.floor(Math.random() * 100).toString().padStart(2, '0');
    return `ING-${acronym}-${num}`;
  }
});
</script>
