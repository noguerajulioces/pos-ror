<div class="px-4 sm:px-6 lg:px-8">
  <!-- Header -->
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold leading-6 text-gray-900"><%= @ingredient.name %></h1>
      <p class="mt-2 text-sm text-gray-700">Detalles del ingrediente</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none space-x-3">
      <%= link_to "Editar", edit_ingredient_path(@ingredient), class: "block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      <%= link_to "Volver", ingredients_path, class: "block rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  </div>

  <!-- Información del ingrediente -->
  <div class="mt-8 bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
    <div class="px-4 py-6 sm:p-8">
      <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
        <!-- Información básica -->
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Información Básica</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Nombre:</span>
              <span class="text-sm font-medium text-gray-900"><%= @ingredient.name %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">SKU:</span>
              <span class="text-sm font-medium text-gray-900"><%= @ingredient.sku %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Unidad:</span>
              <span class="text-sm font-medium text-gray-900"><%= @ingredient.unit.name %></span>
            </div>
          </div>
        </div>

        <!-- Stock y costos -->
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Stock y Costos</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Stock actual:</span>
              <span class="text-sm font-medium text-gray-900"><%= number_with_delimiter(@ingredient.stock, delimiter: '.') %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Stock mínimo:</span>
              <span class="text-sm font-medium text-gray-900"><%= number_with_delimiter(@ingredient.min_stock, delimiter: '.') %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Costo promedio:</span>
              <span class="text-sm font-medium text-gray-900"><%= number_to_currency(@ingredient.average_cost, delimiter: '.', precision: 0, unit: '₲s. ') %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">Estado:</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                <%= case @ingredient.stock_status
                    when 'in_stock' then 'bg-green-100 text-green-800'
                    when 'low_stock' then 'bg-yellow-100 text-yellow-800'
                    when 'out_of_stock' then 'bg-red-100 text-red-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>">
                <%= case @ingredient.stock_status
                    when 'in_stock' then 'En Stock'
                    when 'low_stock' then 'Stock Bajo'
                    when 'out_of_stock' then 'Sin Stock'
                    else 'Desconocido'
                    end %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Productos que usan este ingrediente -->
      <div class="mt-8">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Productos que usan este ingrediente</h3>
        <% if @ingredient.products.any? %>
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cantidad en receta</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @ingredient.products.each do |product| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      <%= link_to product.name, product_path(product), class: "text-indigo-600 hover:text-indigo-900" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= product.kind&.humanize || 'N/A' %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <% component = product.recipe_components.find_by(ingredient: @ingredient) %>
                      <%= component ? "#{component.quantity} #{component.unit.name}" : 'N/A' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">Este ingrediente no está siendo usado en ningún producto.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
