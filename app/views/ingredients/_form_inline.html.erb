<div class="w-full">
  <div class="mb-4">
    <h4 class="text-lg font-medium text-gray-900">Crear Nuevo Ingrediente</h4>
    <p class="mt-1 text-sm text-gray-500">
      Completa los datos básicos del ingrediente
    </p>
  </div>

  <%= form_with model: ingredient, url: ingredients_path, method: :post, 
                data: { turbo: true, ingredient_picker_target: "createFormElement" },
                local: false do |form| %>
    
    <%= form.hidden_field :product_id, value: product.id %>
    
    <div class="space-y-4">
      <div>
        <%= form.label :name, "Nombre", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, 
                           class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                           placeholder: "Ej: Harina de trigo",
                           required: true %>
        <% if ingredient.errors[:name].any? %>
          <p class="mt-1 text-sm text-red-600"><%= ingredient.errors[:name].first %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :unit_id, "Unidad", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <%= form.collection_select :unit_id, 
                                    Unit.all, 
                                    :id, 
                                    :name,
                                    { prompt: "Selecciona una unidad" },
                                    { class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 appearance-none",
                                      required: true } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 12a1 1 0 01-.707-.293l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4A1 1 0 0110 12z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <% if ingredient.errors[:unit_id].any? %>
          <p class="mt-1 text-sm text-red-600"><%= ingredient.errors[:unit_id].first %></p>
        <% end %>
      </div>

      <div class="flex space-x-3 pt-4">
        <%= form.submit "Crear Ingrediente", 
                       class: "flex-1 bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500",
                       data: { disable_with: "Creando..." } %>
        <button type="button" 
                class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500"
                data-action="click->ingredient-picker#hideCreateForm">
          Cancelar
        </button>
      </div>
    </div>
  <% end %>
</div>
